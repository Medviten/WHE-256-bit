diff --git a/data/sql/world/base/0000_playerbots_rpg_races.sql b/data/sql/world/base/0000_playerbots_rpg_races.sql
index 83817b39..4d710490 100644
--- a/data/sql/world/base/0000_playerbots_rpg_races.sql
+++ b/data/sql/world/base/0000_playerbots_rpg_races.sql
@@ -780,3 +780,45 @@ INSERT INTO `playerbots_rpg_races` VALUES
 -- ENDING PLACEHOLDER
 (NULL, 6807, 15, 90, 90)
 ;
+
+-- New races (fixed ids, see SharedDefines.h) share the start area of a stock race, so they get that race's rows.
+-- Rows of races a server does not use are never read. Modpaks that move a race's start can add or replace rows.
+INSERT INTO `playerbots_rpg_races` (`entry`, `race`, `minl`, `maxl`)
+SELECT r.`entry`, n.`race`, r.`minl`, r.`maxl`
+FROM `playerbots_rpg_races` r
+JOIN (
+    SELECT   9 AS race,  2 AS home -- Goblin: Orc
+    UNION ALL SELECT  12 AS race,  2 AS home -- FelOrc: Orc
+    UNION ALL SELECT  13 AS race, 10 AS home -- Naga: BloodElf
+    UNION ALL SELECT  14 AS race, 11 AS home -- Broken: Draenei
+    UNION ALL SELECT  15 AS race,  5 AS home -- Skeleton: Undead
+    UNION ALL SELECT  16 AS race,  1 AS home -- Vrykul: Human
+    UNION ALL SELECT  17 AS race,  3 AS home -- Tuskarr: Dwarf
+    UNION ALL SELECT  18 AS race,  8 AS home -- ForestTroll: Troll
+    UNION ALL SELECT  19 AS race,  6 AS home -- Taunka: Tauren
+    UNION ALL SELECT  20 AS race,  5 AS home -- NorthrendSkeleton: Undead
+    UNION ALL SELECT  21 AS race,  8 AS home -- IceTroll: Troll
+    UNION ALL SELECT  22 AS race,  4 AS home -- Worgen: NightElf
+    UNION ALL SELECT  23 AS race,  4 AS home -- Gilnean: NightElf
+    UNION ALL SELECT  24 AS race,  1 AS home -- Pandaren: Human
+    UNION ALL SELECT  25 AS race,  1 AS home -- AlliancePandaren: Human
+    UNION ALL SELECT  26 AS race,  6 AS home -- HordePandaren: Tauren
+    UNION ALL SELECT  27 AS race, 10 AS home -- Nightborne: BloodElf
+    UNION ALL SELECT  28 AS race,  6 AS home -- HighmountainTauren: Tauren
+    UNION ALL SELECT  29 AS race,  1 AS home -- VoidElf: Human
+    UNION ALL SELECT  30 AS race, 11 AS home -- LightforgedDraenei: Draenei
+    UNION ALL SELECT  31 AS race,  8 AS home -- ZandalariTroll: Troll
+    UNION ALL SELECT  32 AS race,  1 AS home -- KulTiran: Human
+    UNION ALL SELECT  33 AS race,  1 AS home -- ThinHuman: Human
+    UNION ALL SELECT  34 AS race,  3 AS home -- DarkIronDwarf: Dwarf
+    UNION ALL SELECT  35 AS race,  6 AS home -- Vulpera: Tauren
+    UNION ALL SELECT  36 AS race,  2 AS home -- MagharOrc: Orc
+    UNION ALL SELECT  37 AS race,  7 AS home -- Mechagnome: Gnome
+    UNION ALL SELECT  38 AS race,  1 AS home -- HighElf: Human
+    UNION ALL SELECT  39 AS race,  2 AS home -- Ogre: Orc
+    UNION ALL SELECT  40 AS race,  5 AS home -- Darkfallen: Undead
+    UNION ALL SELECT  52 AS race,  1 AS home -- AllianceDracthyr: Human
+    UNION ALL SELECT  70 AS race,  2 AS home -- HordeDracthyr: Orc
+    UNION ALL SELECT  84 AS race,  2 AS home -- HordeEarthen: Orc
+    UNION ALL SELECT  85 AS race,  3 AS home -- AllianceEarthen: Dwarf
+) n ON r.`race` = n.`home`;
