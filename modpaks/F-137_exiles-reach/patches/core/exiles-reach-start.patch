+        me->SetDisableGravity(true);
+        me->SetControlled(true, UNIT_STATE_ROOT);
+        events.ScheduleEvent(EVENT_PRISONER_HELP, 2s);
+    }
+
+    void DoAction(int32 action) override
+    {
+        if (action != ACTION_FREE_PRISONER)
+            return;
+        events.Reset();
+        me->SetControlled(false, UNIT_STATE_ROOT);
+        me->SetDisableGravity(false);
+        me->GetMotionMaster()->MoveJump(PrisonerJumpPosition, 8.0f, 8.0f);
+        me->Say(Alliance() ? LINE_LINDIE_FREED : LINE_CORK_FREED);
+        events.ScheduleEvent(EVENT_PRISONER_RUN, 4s);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        events.Update(diff);
+        switch (events.ExecuteEvent())
+        {
+            case EVENT_PRISONER_HELP:
+                me->Say(Alliance() ? LINE_LINDIE_HELP : LINE_CORK_HELP);
+                break;
+            case EVENT_PRISONER_RUN:
+                me->GetMotionMaster()->MovePoint(0, PrisonerRunPosition);
+                me->DespawnOrUnsummon(5s);
+                break;
+            default:
+                break;
+        }
+    }
+};
+
+// ---- the plains -------------------------------------------------------------------------------------------------
+
+enum PlainsData
+{
+    // F-137's SCOUT_FLIGHTS: taxi nodes of the scouting flights (start, end)
+    TAXI_SCOUT_A_START      = 429,
+    TAXI_SCOUT_A_END        = 430,
+    TAXI_SCOUT_H_START      = 431,
+    TAXI_SCOUT_H_END        = 432,
+
+    SPELL_SHADOW_BOLT       = 695,      // Torgok's Spirit Bolt
+
+    LINE_TORGOK_DEAD_1_A    = 187073,   // Captain Garrick
+    LINE_TORGOK_DEAD_2_A    = 178791,   // Henry Garrick
+    LINE_TORGOK_DEAD_3_A    = 178792,   // Captain Garrick
+    LINE_TORGOK_DEAD_1_H    = 196369,   // Shuja Grimaxe
+    LINE_TORGOK_DEAD_2_H    = 196368,   // Warlord Breka Grimaxe
+};
+
+// 156518 - Scout-o-Matic 5000, 167027 - Choppy Booster Mk. 5: The Scout-o-Matic 5000 / The Choppy Booster Mk. 5.
+// Retail flies the player on the copter (a vehicle) over the ogre ruins, where the camera spots Wrathion, and back;
+// here talking to it takes a taxi flight on the copter along the same path (F-137's SCOUT_FLIGHTS), the camp talking
+// over the radio, and the landing credits the scouting
+struct npc_er_scout_copter : public ScriptedAI
+{
+    npc_er_scout_copter(Creature* creature) : ScriptedAI(creature) { }
+
+    void sGossipHello(Player* player) override
+    {
+        CloseGossipMenuFor(player);
+        bool alliance = me->GetEntry() == NPC_SCOUT_O_MATIC;
+        uint32 quest = alliance ? QUEST_SCOUT_O_MATIC_A : QUEST_CHOPPY_BOOSTER_H;
+        if (player->GetQuestStatus(quest) != QUEST_STATUS_INCOMPLETE || player->IsInFlight())
+            return;
+        std::vector<uint32> nodes = alliance ? std::vector<uint32>{ TAXI_SCOUT_A_START, TAXI_SCOUT_A_END }
+            : std::vector<uint32>{ TAXI_SCOUT_H_START, TAXI_SCOUT_H_END };
+        uint32 credit = me->GetEntry();
+        if (!player->ActivateTaxiPathTo(nodes))
+        {
+            player->KilledMonsterCredit(credit);    // no flight (busy, or the DBC rows missing): the quest still goes on
+            return;
+        }
+        Milliseconds delay = 3s;
+        for (auto const& [speaker, line] : alliance ? std::span(ScoutLinesA) : std::span(ScoutLinesH))
+        {
+            SayLine(player, { speaker }, line, delay, true);
+            delay += 4s;
+        }
+        WaitForLanding(player->GetGUID(), credit);
+    }
+
+    // the scouting is done when the flight is
+    static void WaitForLanding(ObjectGuid guid, uint32 credit)
+    {
+        Player* player = ObjectAccessor::FindPlayer(guid);
+        if (!player)
+            return;
+        player->m_Events.AddEventAtOffset([guid, credit]()
+        {
+            Player* p = ObjectAccessor::FindPlayer(guid);
+            if (!p)
+                return;
+            if (p->IsInFlight())
+                WaitForLanding(guid, credit);
+            else
+                p->KilledMonsterCredit(credit);
+        }, 1s);
+    }
+};
+
+// 162817 - Torgok: the necromancer of the ogre ruins, holding Henry Garrick (Alliance) / Shuja Grimaxe (Horde). Once
+// he dies the leader and the freed prisoner talk (retail's personal copies walk over; here those standing there)
+struct npc_er_torgok : public ScriptedAI
+{
+    npc_er_torgok(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override { events.Reset(); }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        Talk(SAY_AGGRO, who);
+        events.ScheduleEvent(EVENT_ABILITY_1, 2s, 4s);
+    }
+
+    void JustDied(Unit* killer) override
+    {
+        Talk(SAY_DEATH, killer);
+        Player* player = killer ? killer->GetCharmerOrOwnerPlayerOrPlayerItself() : nullptr;
+        if (!player)
+            return;
+        if (IsAlliance(player))
+        {
+            SayLine(player, { NPC_GARRICK_PLAINS }, LINE_TORGOK_DEAD_1_A, 2s);
+            SayLine(player, { NPC_HENRY_PRISONER }, LINE_TORGOK_DEAD_2_A, 6s);
+            SayLine(player, { NPC_GARRICK_PLAINS }, LINE_TORGOK_DEAD_3_A, 11s);
+        }
+        else
+        {
+            SayLine(player, { NPC_SHUJA_PRISONER }, LINE_TORGOK_DEAD_1_H, 2s);
+            SayLine(player, { NPC_GRIMAXE_PLAINS }, LINE_TORGOK_DEAD_2_H, 6s);
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+        events.Update(diff);
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+        if (events.ExecuteEvent() == EVENT_ABILITY_1)
+        {
+            DoCastVictim(SPELL_SHADOW_BOLT);
+            events.ScheduleEvent(EVENT_ABILITY_1, 6s, 9s);
+        }
+        DoMeleeAttackIfReady();
+    }
+};
+
+// ---- the bosses TrinityCore scripts little or not at all ----------------------------------------------------------
+
+struct BossAbility
+{
+    uint32 Spell;
+    Milliseconds First;
+    Milliseconds RepeatMin;
+    Milliseconds RepeatMax;
+    bool OnSelf;            // an area spell around the boss, not on its victim
+    int8 TextGroup;         // creature_text group said as it casts (-1: none)
+};
+
+struct BossInfo
+{
+    uint32 Entry;
+    BossAbility Abilities[2];
+};
+
+// stock NPC spells for retail's
+static BossInfo const Bosses[] =
+{
+    // Tunk (Darkmaul Citadel; TrinityCore's boss_tunk): Interrupting Shout -> Shield Bash, Seismic Slam -> Thunderclap,
+    // with his warnings (raid boss whispers)
+    { 157300, { { 72, 7s, 20s, 20s, false, 1 }, { 8078, 14s, 30s, 30s, true, 0 } } },
+    // Gor'groth (Darkmaul Citadel's end): the ritual's necromancer
+    { 156814, { { 695, 3s, 6s, 9s, false, -1 }, { 8078, 12s, 15s, 20s, true, -1 } } },
+    // Hrun the Exiled (Hrun's pit)
+    { 156900, { { 11976, 4s, 8s, 12s, false, -1 }, { 8078, 10s, 15s, 20s, true, -1 } } },
+    // Bloodbeak (the harpies' ritual)
+    { 153964, { { 695, 3s, 7s, 10s, false, -1 }, { 6253, 9s, 15s, 20s, false, -1 } } },
+};
+
+// Tunk, Gor'groth, Hrun the Exiled, Bloodbeak: a boss's two abilities on a timer (Bosses)
+struct npc_er_boss : public ScriptedAI
+{
+    npc_er_boss(Creature* creature) : ScriptedAI(creature) { }
+
+    BossInfo const* Info() const
+    {
+        for (BossInfo const& info : Bosses)
+            if (info.Entry == me->GetEntry())
+                return &info;
+        return nullptr;
+    }
+
+    void Reset() override { events.Reset(); }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        if (BossInfo const* info = Info())
+            for (uint32 i = 0; i < 2; ++i)
+                if (info->Abilities[i].Spell)
+                    events.ScheduleEvent(i + 1, info->Abilities[i].First);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+        events.Update(diff);
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+        BossInfo const* info = Info();
+        if (uint32 eventId = events.ExecuteEvent(); info && eventId >= 1 && eventId <= 2)
+        {
+            BossAbility const& ability = info->Abilities[eventId - 1];
+            if (ability.TextGroup >= 0)
+                Talk(ability.TextGroup, me->GetVictim());
+            if (ability.OnSelf)
+                DoCastAOE(ability.Spell);
+            else
+                DoCastVictim(ability.Spell);
+            events.ScheduleEvent(eventId, ability.RepeatMin, ability.RepeatMax);
+        }
+        DoMeleeAttackIfReady();
+    }
+};
+
+void AddSC_exiles_reach()
+{
+    new ExilesReachQuestScript();
+    RegisterCreatureAI(npc_er_ship_sparring);
+    RegisterCreatureAI(npc_er_beach_survivor);
+    RegisterCreatureAI(npc_er_follower);
+    RegisterCreatureAI(npc_er_combat_trainer);
+    RegisterCreatureAI(npc_er_quilboar);
+    RegisterCreatureAI(npc_er_ogre_overseer);
+    RegisterCreatureAI(npc_er_geolord);
+    RegisterCreatureAI(npc_er_briarpatch_prisoner);
+    RegisterCreatureAI(npc_er_scout_copter);
+    RegisterCreatureAI(npc_er_torgok);
+    RegisterCreatureAI(npc_er_boss);
+}
diff --git a/src/server/scripts/Custom/exiles_reach_start.cpp b/src/server/scripts/Custom/exiles_reach_start.cpp
new file mode 100644
index 000000000..57e7b9a9b
--- /dev/null
+++ b/src/server/scripts/Custom/exiles_reach_start.cpp
@@ -0,0 +1,120 @@
+/*
+ * Custom: F-137 Exile's Reach start.
+ *
+ * F-137 moves the start (playercreateinfo) of the races whose player_race_template row has exiles_reach = 1 (most
+ * custom races; stock races and those that fit a stock or their own start keep it) to the island's beach. With
+ * ExilesReachStartZone.Enable on, those new characters (not Death Knights, not those the Wandering Isle start takes)
+ * start instead aboard their faction's ship sailing to the island, as retail's new player experience does: the
+ * Alliance Ship (transport 13701) or the Horde Transport (13702), on retail's deck spot. The ships are F-137's
+ * continent transports on map 2175; the character row is saved before this hook runs, so it gets the transport and
+ * the deck offset written directly, and the first login puts the character aboard the way it restores anyone who
+ * logged out on a transport (Player::LoadFromDB). With the ship missing (EnableContinentTransport off) the character
+ * starts on the beach.
+ *
+ * The way off the island, as retail: Kalecgos, freed at the end of Darkmaul Citadel, credits "Speak with Kalecgos to
+ * leave" and takes the player out to the citadel's gate; there Lady Jaina Proudmoore / Thrall give An End to
+ * Beginnings, and talking to Kalecgos at the gate credits it and sends the player to their capital, bound there (as
+ * the Wandering Isle's finale does), where Captain Garrick / Warlord Breka Grimaxe end it (F-137 spawns them).
+ */
+
+#include "AreaDefines.h"
+#include "CreatureScript.h"
+#include "DatabaseEnv.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "PlayerScript.h"
+#include "ScriptedGossip.h"
+#include "World.h"
+
+enum ExilesReachStart
+{
+    MAP_EXILES_REACH            = 2175,
+    TRANSPORT_ALLIANCE_SHIP     = 13701,
+    TRANSPORT_HORDE_SHIP        = 13702,
+    QUEST_SANDY_FIST            = 29406,    // F-134: only the races starting on the Wandering Isle may take it
+    CREDIT_LEAVE_ALLIANCE       = 161350,   // "Speak with Kalecgos to leave Darkmaul Citadel"
+    CREDIT_LEAVE_HORDE          = 167663,
+    CREDIT_TRAVEL               = 244389,   // "Speak to Kalecgos to travel ..." (An End to Beginnings)
+    QUEST_END_TO_BEGINNINGS_ALLIANCE    = 55991,
+    QUEST_END_TO_BEGINNINGS_HORDE       = 59985,
+};
+
+// TrinityCore's world_safe_locs 100097: outside the citadel's gate
+static WorldLocation const DarkmaulGate(MAP_EXILES_REACH, 721.7f, -1838.4f, 186.5f, 4.3266f);
+
+// retail's playercreateinfo deck spots (TrinityCore: transport guids 29 and 30), relative to the ship
+static Position const AllianceDeck = { 11.1301f, -0.417182f, 5.18741f, 3.14843f };
+static Position const HordeDeck = { -10.7291f, -7.14635f, 8.73113f, 1.56321f };
+
+class ExilesReachStartPlayerScript : public PlayerScript
+{
+public:
+    ExilesReachStartPlayerScript() : PlayerScript("ExilesReachStartPlayerScript", { PLAYERHOOK_ON_CREATE }) { }
+
+    void OnPlayerCreate(Player* player) override
+    {
+        if (!sWorld->getBoolConfig(CONFIG_EXILES_REACH_START_ZONE) || player->getClass() == CLASS_DEATH_KNIGHT ||
+            player->GetMapId() != MAP_EXILES_REACH)
+            return;
+        // the Wandering Isle start moves them on their first login
+        Quest const* wanderingIsle = sObjectMgr->GetQuestTemplate(QUEST_SANDY_FIST);
+        if (sWorld->getBoolConfig(CONFIG_WANDERING_ISLE_START_ZONE) && wanderingIsle &&
+            player->SatisfyQuestRace(wanderingIsle, false))
+            return;
+
+        bool alliance = player->GetTeamId(true) == TEAM_ALLIANCE;
+        Position const& deck = alliance ? AllianceDeck : HordeDeck;
+        CharacterDatabase.Execute("UPDATE characters SET transguid = {}, trans_x = {}, trans_y = {}, trans_z = {}, "
+            "trans_o = {} WHERE guid = {}", uint32(alliance ? TRANSPORT_ALLIANCE_SHIP : TRANSPORT_HORDE_SHIP),
+            deck.GetPositionX(), deck.GetPositionY(), deck.GetPositionZ(), deck.GetOrientation(),
+            player->GetGUID().GetCounter());
+    }
+};
+
+// 156501 - Kalecgos, freed at the end of Darkmaul Citadel
+class npc_darkmaul_kalecgos : public CreatureScript
+{
+public:
+    npc_darkmaul_kalecgos() : CreatureScript("npc_darkmaul_kalecgos") { }
+
+    bool OnGossipHello(Player* player, Creature* /*creature*/) override
+    {
+        CloseGossipMenuFor(player);
+        player->KilledMonsterCredit(CREDIT_LEAVE_ALLIANCE);
+        player->KilledMonsterCredit(CREDIT_LEAVE_HORDE);
+        player->TeleportTo(DarkmaulGate);
+        return true;
+    }
+};
+
+// 244389 - Kalecgos, at Darkmaul Citadel's gate: the flight off the island
+class npc_exiles_reach_kalecgos : public CreatureScript
+{
+public:
+    npc_exiles_reach_kalecgos() : CreatureScript("npc_exiles_reach_kalecgos") { }
+
+    bool OnGossipHello(Player* player, Creature* /*creature*/) override
+    {
+        // only on An End to Beginnings (Alliance / Horde): anyone else gets his ordinary greeting
+        if (player->GetQuestStatus(QUEST_END_TO_BEGINNINGS_ALLIANCE) != QUEST_STATUS_INCOMPLETE &&
+            player->GetQuestStatus(QUEST_END_TO_BEGINNINGS_HORDE) != QUEST_STATUS_INCOMPLETE)
+            return false;
+        CloseGossipMenuFor(player);
+        player->KilledMonsterCredit(CREDIT_TRAVEL);
+
+        bool alliance = player->GetTeamId() == TEAM_ALLIANCE;
+        WorldLocation home = alliance
+            ? WorldLocation(MAP_EASTERN_KINGDOMS, -8833.38f, 628.63f, 94.01f, 1.07f)     // Stormwind, Trade District
+            : WorldLocation(MAP_KALIMDOR, 1633.75f, -4439.39f, 15.43f, 0.0f);          // Orgrimmar, Valley of Strength
+        player->SetHomebind(home, alliance ? AREA_STORMWIND_CITY : AREA_ORGRIMMAR);
+        player->TeleportTo(home);
+        return true;
+    }
+};
+
+void AddSC_exiles_reach_start()
+{
+    new ExilesReachStartPlayerScript();
+    new npc_darkmaul_kalecgos();
+    new npc_exiles_reach_kalecgos();
+}
