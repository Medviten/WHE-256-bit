+// The scouting flight's lines over the radio: (speaker, line) at 4 second steps; the engineer and the leader
+static std::pair<uint32, uint32> const ScoutLinesA[] = { { NPC_LINDIE_PLAINS, 178693 }, { NPC_GARRICK_PLAINS, 291044 },
+    { NPC_LINDIE_PLAINS, 178695 }, { NPC_LINDIE_PLAINS, 178696 }, { NPC_GARRICK_PLAINS, 291045 } };
+static std::pair<uint32, uint32> const ScoutLinesH[] = { { NPC_CORK_PLAINS, 196290 }, { NPC_GRIMAXE_PLAINS, 290966 },
