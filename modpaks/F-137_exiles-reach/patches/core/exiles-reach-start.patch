+class ExilesReachQuestScript : public PlayerScript
+{
+public:
+    ExilesReachQuestScript() : PlayerScript("ExilesReachQuestScript",
+        { PLAYERHOOK_ON_PLAYER_QUEST_ACCEPT, PLAYERHOOK_ON_PLAYER_COMPLETE_QUEST }) { }
+
+    void OnPlayerQuestAccept(Player* player, Quest const* quest) override
+    {
+        switch (quest->GetQuestId())
+        {
+            case QUEST_WARMING_UP_A:
+                SayLine(player, { NPC_GARRICK_SHIP }, LINE_WARMING_UP_ACCEPT_A);
+                break;
+            case QUEST_WARMING_UP_H:
+                SayLine(player, { NPC_GRIMAXE_SHIP_LOWER, NPC_GRIMAXE_SHIP_LOWER2 }, LINE_WARMING_UP_ACCEPT_H);
+                break;
+            case QUEST_BRACE_FOR_IMPACT_A:
+                SayLine(player, { NPC_GARRICK_SHIP }, LINE_BELOW_DECKS_A);
+                SayLine(player, { NPC_COLE_SHIP }, LINE_STORM_A, 3s);
+                break;
+            case QUEST_BRACE_FOR_IMPACT_H:
+                SayLine(player, { NPC_GRIMAXE_SHIP_UPPER, NPC_GRIMAXE_SHIP_LOWER }, LINE_BELOW_DECKS_H);
+                SayLine(player, { NPC_THROG_SHIP }, LINE_STORM_H, 3s);
+                break;
+            case QUEST_MURLOC_MANIA_A:
+                SayLine(player, { NPC_GARRICK_BEACH }, LINE_MURLOC_MANIA_A);
+                break;
+            case QUEST_MURLOC_MANIA_H:
+                SayLine(player, { NPC_GRIMAXE_BEACH }, LINE_MURLOC_MANIA_H);
+                break;
+            case QUEST_FINDING_THE_LOST_EXPEDITION_A:
+            case QUEST_FINDING_THE_LOST_EXPEDITION_H:
+                SummonFollower(player, IsAlliance(player) ? NPC_GARRICK_FOLLOWER : NPC_GRIMAXE_FOLLOWER);
+                break;
+            case QUEST_ENHANCED_COMBAT_TACTICS_A:
+            case QUEST_ENHANCED_COMBAT_TACTICS_H:
+                SummonFollower(player, IsAlliance(player) ? NPC_TRAINER_A : NPC_TRAINER_H);
+                break;
+            case QUEST_NORTHBOUND_A:
+            case QUEST_NORTHBOUND_H:
+                SummonFollower(player, IsAlliance(player) ? NPC_GARRICK_NORTHBOUND : NPC_GRIMAXE_NORTHBOUND);
+                break;
+            case QUEST_TAMING_THE_WILDS_A:
+            case QUEST_TAMING_THE_WILDS_H:
+                TeachTaming(player);
+                break;
+            case QUEST_DOWN_WITH_THE_QUILBOAR_A:
+            case QUEST_QUILBOAR_NECROMANCY_A:
+                // with both of the Briarpatch's quests taken the leader and the scout set off (retail's
+                // "validated quest accept")
+                if (player->GetQuestStatus(QUEST_DOWN_WITH_THE_QUILBOAR_A) != QUEST_STATUS_NONE &&
+                    player->GetQuestStatus(QUEST_QUILBOAR_NECROMANCY_A) != QUEST_STATUS_NONE)
+                {
+                    SayLine(player, { NPC_GARRICK_BRIARPATCH }, LINE_BRIARPATCH_1_A);
+                    SayLine(player, { NPC_HUXWORTH_BRIARPATCH }, LINE_BRIARPATCH_2_A, 4s);
+                    SayLine(player, { NPC_GARRICK_BRIARPATCH }, LINE_BRIARPATCH_3_A, 9s);
+                }
+                break;
+            case QUEST_DOWN_WITH_THE_QUILBOAR_H:
+            case QUEST_QUILBOAR_NECROMANCY_H:
+                if (player->GetQuestStatus(QUEST_DOWN_WITH_THE_QUILBOAR_H) != QUEST_STATUS_NONE &&
+                    player->GetQuestStatus(QUEST_QUILBOAR_NECROMANCY_H) != QUEST_STATUS_NONE)
+                {
+                    SayLine(player, { NPC_GRIMAXE_BRIARPATCH }, LINE_BRIARPATCH_1_H);
+                    SayLine(player, { NPC_DAWNTRACKER_BRIARPATCH }, LINE_BRIARPATCH_2_H, 4s);
+                    SayLine(player, { NPC_GRIMAXE_BRIARPATCH }, LINE_BRIARPATCH_3_H, 9s);
+                }
+                break;
+            case QUEST_SCOUT_O_MATIC_A:
+                SayLine(player, { NPC_LINDIE_PLAINS }, LINE_COPTER_1_A);
+                SayLine(player, { NPC_LINDIE_PLAINS }, LINE_COPTER_2_A, 5s);
+                SayLine(player, { NPC_LINDIE_PLAINS }, LINE_COPTER_3_A, 10s);
+                break;
+            case QUEST_CHOPPY_BOOSTER_H:
+                SayLine(player, { NPC_CORK_PLAINS }, LINE_COPTER_1_H);
+                SayLine(player, { NPC_CORK_PLAINS }, LINE_COPTER_2_H, 5s);
+                SayLine(player, { NPC_CORK_PLAINS }, LINE_COPTER_3_H, 10s);
+                break;
+            case QUEST_RESIZING_A:
+                SayLine(player, { NPC_LINDIE_PLAINS }, LINE_RESIZING_A);
+                break;
+            case QUEST_RESIZING_H:
+                SayLine(player, { NPC_CORK_PLAINS }, LINE_RESIZING_H);
+                break;
+            case QUEST_BOAR_RIDE_A:
+                SayLine(player, { NPC_GARRICK_PLAINS }, LINE_BOAR_RIDE_A);
+                break;
+            case QUEST_RE_DEATHER_H:
+                SayLine(player, { NPC_CORK_PLAINS }, LINE_RE_DEATHER_H);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void OnPlayerCompleteQuest(Player* player, Quest const* quest) override
+    {
+        switch (quest->GetQuestId())
+        {
+            case QUEST_WARMING_UP_A:
+                SayLine(player, { NPC_GARRICK_SHIP }, LINE_WARMING_UP_DONE_A);
+                break;
+            case QUEST_WARMING_UP_H:
+                SayLine(player, { NPC_GRIMAXE_SHIP_LOWER, NPC_GRIMAXE_SHIP_LOWER2 }, LINE_WARMING_UP_DONE_H);
+                break;
+            case QUEST_BRACE_FOR_IMPACT_A:      // shipwrecked: the turn-in lands the player on the beach
+                SayLine(player, { NPC_GARRICK_BEACH }, LINE_BEACH_ARRIVAL_A, 4s);
+                break;
+            case QUEST_BRACE_FOR_IMPACT_H:
+                SayLine(player, { NPC_GRIMAXE_BEACH }, LINE_BEACH_ARRIVAL_H, 4s);
+                break;
+            case QUEST_COOKING_MEAT_A:
+                SayLine(player, { NPC_ALARIA_CAMP }, LINE_COOKING_DONE_A);
+                SayLine(player, { NPC_GARRICK_CAMP }, LINE_COOKING_LEADER_A, 4s);
+                break;
+            case QUEST_COOKING_MEAT_H:
+                SayLine(player, { NPC_WONSA_CAMP }, LINE_COOKING_DONE_H);
+                SayLine(player, { NPC_GRIMAXE_CAMP }, LINE_COOKING_LEADER_H, 4s);
+                break;
+            default:
+                break;
+        }
+    }
+
+private:
+    // Taming the Wilds: the hunter scout teaches taming (retail's level 1 hunters lack it; 3.3.5a's learn it at 10):
+    // Tame Beast and the pet spells, then sends the player off to tame a beast
+    static void TeachTaming(Player* player)
+    {
+        bool alliance = IsAlliance(player);
+        uint32 scout = alliance ? NPC_HUXWORTH_BRIARPATCH : NPC_DAWNTRACKER_BRIARPATCH;
+        SayLine(player, { scout }, alliance ? LINE_TAMING_TEACH_A : LINE_TAMING_TEACH_H);
+        ObjectGuid guid = player->GetGUID();
+        player->m_Events.AddEventAtOffset([guid]()
+        {
+            Player* p = ObjectAccessor::FindPlayer(guid);
+            if (!p || p->getClass() != CLASS_HUNTER)
+                return;
+            for (uint32 spell : { 1515u, 883u, 2641u, 982u, 6991u })    // Tame Beast, Call / Dismiss / Revive / Feed Pet
+                if (!p->HasSpell(spell))
+                    p->learnSpell(spell);
+        }, 6s);
+        SayLine(player, { scout }, alliance ? LINE_TAMING_FIND_A : LINE_TAMING_FIND_H, 7s);
+    }
+
+    // a personal summon beside the player: a leader following them (npc_er_follower), Enhanced Combat Tactics'
+    // trainer (npc_er_combat_trainer)
+    static void SummonFollower(Player* player, uint32 entry)
+    {
+        Position pos = player->GetNearPosition(2.0f, static_cast<float>(M_PI) / 2);
+        player->SummonCreature(entry, pos, TEMPSUMMON_MANUAL_DESPAWN, 0, 0, nullptr, true);
+    }
+};
