+static Position const AbandonedCamp = { -249.059f, -2492.52f, 18.0742f, 0.0f };
+
+// A conversation line: the speaker (the nearest creature of the entries) says the broadcast text to the player,
+// after a delay (the speaker looked up again then, so it may have despawned or moved away meanwhile). A whisper
+// reaches the player wherever they are (lines over the radio, retail's talking heads far from the speaker)
+static void SayLine(Player* player, std::initializer_list<uint32> entries, uint32 broadcastTextId,
+    Milliseconds delay = 0ms, bool whisper = false)
+{
+    std::vector<uint32> speakers(entries);
+    ObjectGuid playerGuid = player->GetGUID();
+    auto say = [playerGuid, speakers, broadcastTextId, whisper]()
+    {
+        Player* p = ObjectAccessor::FindPlayer(playerGuid);
+        if (!p)
+            return;
+        Creature* best = nullptr;
+        for (uint32 entry : speakers)
+            if (Creature* c = p->FindNearestCreature(entry, whisper ? 300.0f : 60.0f, true))
+                if (!best || p->GetDistance(c) < p->GetDistance(best))
+                    best = c;
+        if (best && whisper)
+            best->Whisper(broadcastTextId, p);
+        else if (best)
+            best->Say(broadcastTextId, p);
+    };
+    if (delay == 0ms)
+        say();
+    else
+        player->m_Events.AddEventAtOffset(std::move(say), delay);
+}
