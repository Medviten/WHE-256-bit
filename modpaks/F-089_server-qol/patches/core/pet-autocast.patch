diff --git a/src/server/apps/worldserver/worldserver.conf.dist b/src/server/apps/worldserver/worldserver.conf.dist
index 9af68cd22..89d4b6bad 100644
--- a/src/server/apps/worldserver/worldserver.conf.dist
+++ b/src/server/apps/worldserver/worldserver.conf.dist
@@ -1638,6 +1638,17 @@ DisableWaterBreath = 4
 
 DisableFatigue = 1
 
+#
+#    PetAutocastNewSpells
+#        Description: Pet spells that need a target (Firebolt, Bite, Claw, ...) start with autocast on
+#                     when the pet learns them, as on retail. An imp only attacks by autocasting Firebolt,
+#                     so with this off a new imp ignores the Attack command until Firebolt is set to
+#                     autocast. Spells pets already know keep their saved setting.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, stock behaviour: new pet spells start with autocast off)
+
+PetAutocastNewSpells = 1
+
 #
 #    AllFlightPaths
 #        Description: Character knows all flight paths (of both factions) after creation.
diff --git a/src/server/game/Entities/Pet/Pet.cpp b/src/server/game/Entities/Pet/Pet.cpp
index c58f4cc10..55dcb47e1 100644
--- a/src/server/game/Entities/Pet/Pet.cpp
+++ b/src/server/game/Entities/Pet/Pet.cpp
@@ -1809,8 +1809,11 @@ bool Pet::addSpell(uint32 spellId, ActiveStates active /*= ACT_DECIDE*/, PetSpel
 
     if (active == ACT_DECIDE)                               // active was not used before, so we save it's autocast/passive state here
     {
+        // Custom: F-089 PetAutocastNewSpells, targeted spells start on autocast as on retail (an imp attacks only by
+        // autocasting Firebolt)
         if (spellInfo->IsAutocastable())
-            newspell.active = ACT_DISABLED;
+            newspell.active = sWorld->getBoolConfig(CONFIG_PET_AUTOCAST_NEW_SPELLS) && spellInfo->NeedsExplicitUnitTarget()
+                ? ACT_ENABLED : ACT_DISABLED;
         else
             newspell.active = ACT_PASSIVE;
     }
@@ -1871,8 +1874,8 @@ bool Pet::addSpell(uint32 spellId, ActiveStates active /*= ACT_DECIDE*/, PetSpel
 
     if (spellInfo->IsPassive())
         CastSpell(this, spellId, true);
-    else
-        m_charmInfo->AddSpellToActionBar(spellInfo);
+    else // Custom: F-089, the bar shows a spell PetAutocastNewSpells turned on as autocast
+        m_charmInfo->AddSpellToActionBar(spellInfo, newspell.active == ACT_ENABLED ? ACT_ENABLED : ACT_DECIDE);
 
     // unapply aura stats if dont meet requirements
     if (Aura* aura = GetAura(spellId))
