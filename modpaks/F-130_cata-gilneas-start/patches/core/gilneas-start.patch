+struct npc_gilneas_liam_camera : public ScriptedAI
+{
+    // the donor moved the camera target at points 1 and 3
+    npc_gilneas_liam_camera(Creature* creature) : ScriptedAI(creature), _summons(me), _path(LiamCameraPath, { 1, 3, 6 }) { }
+
+    enum Events { EVENT_SCENE_START = 1, EVENT_SCENE_END };
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        me->setActive(true);
+        me->SetReactState(REACT_PASSIVE);
+        if (Unit* unit = summoner->ToUnit())
+            unit->CastSpell(me, SPELL_RIDE_VEHICLE, true);
+    }
+
+    void JustSummoned(Creature* summon) override { _summons.Summon(summon); }
+
+    void PassengerBoarded(Unit* passenger, int8 /*seatId*/, bool apply) override
+    {
+        Player* player = passenger->ToPlayer();
+        if (!player)
+            return;
+        if (!apply)
+        {
+            _summons.DespawnAll();
+            if (Creature* doppel = ObjectAccessor::GetCreature(*me, _doppelGUID))
+                doppel->DespawnOrUnsummon();
+            me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+            me->DespawnOrUnsummon(1s);
+            return;
+        }
+        _playerGUID = player->GetGUID();
+        me->SummonCreature(NPC_SCENE_LORNA, ActorLocations[0], TEMPSUMMON_MANUAL_DESPAWN);
+        me->SummonCreature(NPC_SCENE_KING_GREYMANE, ActorLocations[1], TEMPSUMMON_MANUAL_DESPAWN);
+        me->SummonCreature(NPC_SCENE_LORD_CROWLEY, ActorLocations[2], TEMPSUMMON_MANUAL_DESPAWN);
+        if (Creature* doppel = player->SummonCreature(NPC_SCENE_DOPPELGANGER, ActorLocations[3], TEMPSUMMON_MANUAL_DESPAWN))
+            _doppelGUID = doppel->GetGUID();
+        if (Creature* camera = me->SummonCreature(NPC_SCENE_CAMERA_TARGET, ActorLocations[4], TEMPSUMMON_MANUAL_DESPAWN))
+            _cameraGUID = camera->GetGUID();
+        CastLater(me, me->GetGUID(), SPELL_LIAM_CHANNEL, 100ms);
+        _events.ScheduleEvent(EVENT_SCENE_START, 1s);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        int leg = _path.Ended(me);
+        if (leg == 0 || leg == 1)
+        {
+            if (Creature* camera = ObjectAccessor::GetCreature(*me, _cameraGUID))
+                camera->GetMotionMaster()->MovePoint(leg, ActorLocations[5 + leg]);
+            _path.Continue(me);
+        }
+
+        _events.Update(diff);
+        while (uint32 id = _events.ExecuteEvent())
+        {
+            Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID);
+            if (id == EVENT_SCENE_START)
+            {
+                _path.Start(me);
+                uint32 const delays[] = { 5000, 14000, 21000, 29500, 39000 };
+                for (uint8 i = 0; i < 5; ++i)
+                    Talk(i, player, Milliseconds(delays[i]));
+                if (player)
+                    CastLater(player, player->GetGUID(), SPELL_BLESSING_END, 45500ms);
+                _events.ScheduleEvent(EVENT_SCENE_END, 47s);
+            }
+            else if (player)
+                player->ExitVehicle();
+        }
+
+        if (_checkTimer > diff)
+        {
+            _checkTimer -= diff;
+            return;
+        }
+        _checkTimer = 1000;
+        if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+        {
+            if (QuestNoneOrRewarded(player, QUEST_PATRIARCHS_BLESSING))
+                player->ExitVehicle();
+            else if (me->GetDistance(player) >= 150.0f)
+            {
+                me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+                me->DespawnOrUnsummon(100ms);
+            }
+        }
+    }
+
+private:
+    SummonList _summons;
+    GilneasPath _path;
+    EventMap _events;
+    ObjectGuid _playerGUID, _cameraGUID, _doppelGUID;
+    uint32 _checkTimer = 1000;
+};
