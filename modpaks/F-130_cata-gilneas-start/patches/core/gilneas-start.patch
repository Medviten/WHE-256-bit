+/* q14222 "Last Stand" .. q14375 "Last Chance at Humanity": a Worgen who logs out in the stocks of Greymane Manor gets
+ * the curse back on login, unless their own Krennan is already there. */
+enum Stocks
+{
+    QUEST_LAST_STAND                = 14222,
+    QUEST_LAST_CHANCE_AT_HUMANITY   = 14375,
+    AREA_GREYMANE_MANOR_STOCKS      = 4786,
+    NPC_KRENNAN_ARANAS_STOCKS       = 36331,
+    SPELL_CURSE_OF_THE_WORGEN       = 68630,
+};
+
+class StocksPlayerScript : public PlayerScript
+{
+public:
+    StocksPlayerScript() : PlayerScript("StocksPlayerScript", { PLAYERHOOK_ON_LOGIN }) { }
+
+    void OnPlayerLogin(Player* player) override
+    {
+        if (!sWorld->getBoolConfig(CONFIG_GILNEAS_START_ZONE) || player->GetAreaId() != AREA_GREYMANE_MANOR_STOCKS)
+            return;
+        if (!player->GetQuestRewardStatus(QUEST_LAST_STAND) || player->GetQuestRewardStatus(QUEST_LAST_CHANCE_AT_HUMANITY))
+            return;
+
+        std::list<Creature*> krennans;
+        player->GetCreatureListWithEntryInGrid(krennans, NPC_KRENNAN_ARANAS_STOCKS, 100.0f);
+        for (Creature* krennan : krennans)
+            if (krennan->GetOwnerGUID() == player->GetGUID())
+                return;
+        player->CastSpell(player, SPELL_CURSE_OF_THE_WORGEN, true);
+    }
+};
