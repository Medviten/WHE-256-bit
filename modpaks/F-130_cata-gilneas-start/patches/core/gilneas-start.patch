+/* q14395 "Gasping for Breath": the player carries a drowning watchman out of the water to King Greymane. */
+enum DrowningWatchman
+{
+    SPELL_SET_VEHICLE_ID        = 68735,
+    SPELL_DROWNING              = 68730,
+    SPELL_RIDE_PLAYER           = 47020,
+    NPC_GREYMANE_GASPING        = 36451,
+    NPC_GASPING_CREDIT          = 36450,
+    QUEST_GASPING_FOR_BREATH    = 14395,
+};
