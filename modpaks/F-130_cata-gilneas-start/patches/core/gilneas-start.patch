+struct npc_stagecoach_harness_worgen : public ScriptedAI
+{
+    npc_stagecoach_harness_worgen(Creature* creature) : ScriptedAI(creature),
+        _out(StageCoachPath, { 34 }), _away(StageCoachPath2, { 4 }) { }
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        me->setActive(true);
+        me->SetControlled(true, UNIT_STATE_ROOT);
+        if (Player* player = summoner->ToPlayer())
+            _playerGUID = player->GetGUID();
+    }
+
+    void PassengerBoarded(Unit* passenger, int8 /*seatId*/, bool apply) override
+    {
+        Creature* creature = passenger->ToCreature();
+        if (!apply || !creature)
+            return;
+        if (creature->GetEntry() == NPC_STAGECOACH_HORSE)
+            creature->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+        else if (creature->GetEntry() == NPC_STAGECOACH_CARRIAGE)
+        {
+            _carriageGUID = creature->GetGUID();
+            if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+            {
+                player->KilledMonsterCredit(me->GetEntry());
+                // the donor's 72764 "Ride Stagecoach" has an effect 3.3.5a lacks; boarding directly does the same
+                ObjectGuid carriage = _carriageGUID;
+                player->m_Events.AddEventAtOffset([player, carriage]()
+                {
+                    if (Unit* c = ObjectAccessor::GetUnit(*player, carriage))
+                        player->EnterVehicle(c);
+                }, 300ms);
+                _startTimer = 2000;
+            }
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (_startTimer)
+        {
+            if (_startTimer <= diff)
+            {
+                _startTimer = 0;
+                me->SetControlled(false, UNIT_STATE_ROOT);
+                _out.Start(me);
+                OpenGate(me, GO_GREYMANE_GATE, 4);
+            }
+            else
+                _startTimer -= diff;
+        }
+
+        if (_out.Ended(me) == 0)            // donor point 34: at the coast, the passenger jumps off
+        {
+            if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+            {
+                player->ExitVehicle();
+                player->GetMotionMaster()->MoveJump(-2216.684f, 1817.42f, 12.416f, 15.0f, 18.0f);
+            }
+            if (Creature* carriage = ObjectAccessor::GetCreature(*me, _carriageGUID))
+                carriage->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+            _away.Start(me);
+        }
+        if (_away.Ended(me) == 0)
+            me->DespawnOrUnsummon();
+
+        if (_checkTimer > diff)
+        {
+            _checkTimer -= diff;
+            return;
+        }
+        _checkTimer = 2000;
+        if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+        {
+            if (QuestNoneOrRewarded(player, QUEST_EXODUS))
+            {
+                player->ExitVehicle();
+                me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+                me->DespawnOrUnsummon();
+            }
+            else if (me->GetDistance(player) > 1000.0f)
+                me->DespawnOrUnsummon();
+        }
+    }
