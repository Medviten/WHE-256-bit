+struct npc_mountain_horse_worgen : public ScriptedAI
+{
+    npc_mountain_horse_worgen(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _credited = false;          // the donor's marker aura 151100
+        _inUse = false;
+    }
+
+    uint32 GetData(uint32 id) const override { return id == DATA_HORSE_CREDITED && _credited ? 1 : 0; }
+
+    void PassengerBoarded(Unit* passenger, int8 /*seatId*/, bool apply) override
+    {
+        if (!passenger->IsPlayer())
+            return;
+        if (apply)
+        {
+            _inUse = true;
+            _playerGUID = passenger->GetGUID();
+            return;
+        }
+        _inUse = false;
+        passenger->RemoveAurasDueToSpell(SPELL_ROUND_UP_HORSE_STACK);
+        me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+        me->DespawnOrUnsummon(_credited ? 7s : 0s);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _inUse = false;
+        _credited = false;
+        if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+            player->RemoveAurasDueToSpell(SPELL_ROUND_UP_HORSE_STACK);
+    }
+
+    void SpellHit(Unit* caster, SpellInfo const* spell) override
+    {
+        if (spell->Id == SPELL_ROUND_UP_HORSE && caster)
+        {
+            if (me->GetVehicleKit() && me->GetVehicleKit()->IsVehicleInUse())
+                return;
+            me->SetFacingToObject(caster);
+            me->DespawnOrUnsummon(100ms);
+        }
+        else if (spell->Id == SPELL_LORNA_PING_HORSE && _inUse)
+        {
+            _inUse = false;
+            if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+            {
+                _credited = true;
+                player->ExitVehicle();
+                player->KilledMonsterCredit(NPC_CREDIT_HORSE);
+            }
+        }
+    }
+
+    void UpdateAI(uint32 /*diff*/) override { }
+
+private:
+    bool _inUse = false;
+    bool _credited = false;
+    ObjectGuid _playerGUID;
+};
