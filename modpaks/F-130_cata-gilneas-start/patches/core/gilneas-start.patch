+struct npc_king_greymanes_horse : public ScriptedAI
+{
+    npc_king_greymanes_horse(Creature* creature) : ScriptedAI(creature),
+        _out(KingHorsePath, { 6 }), _back(KingHorsePath2, { 13 }) { }
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        me->SetControlled(true, UNIT_STATE_ROOT);
+        me->SetReactState(REACT_PASSIVE);
+        if (Player* player = summoner->ToPlayer())
+        {
+            _playerGUID = player->GetGUID();
+            CastLater(player, me->GetGUID(), SPELL_RIDE_VEHICLE, 150ms);
+        }
+    }
+
+    void PassengerBoarded(Unit* passenger, int8 /*seatId*/, bool apply) override
+    {
+        if (!apply)
+            return;
+        if (passenger->IsPlayer())
+            _startTimer = 2000;
+        else if (passenger->GetEntry() == NPC_KRENNAN_ARANAS_SAVED)
+        {
+            me->SetControlled(false, UNIT_STATE_ROOT);
+            _back.Start(me);
+        }
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        if (Creature* krennan = ObjectAccessor::GetCreature(*me, _savedKrennanGUID))
+            krennan->DespawnOrUnsummon();
+        if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+            player->ExitVehicle();
+    }
+
+    void SpellHit(Unit* /*caster*/, SpellInfo const* spell) override
+    {
+        if (spell->Id != SPELL_RESCUE_KRENNAN || _savedKrennanGUID)
+            return;
+        if (Creature* saved = me->SummonCreature(NPC_KRENNAN_ARANAS_SAVED, -1674.95f, 1347.94f, 22.2527f, 0.764106f,
+                                                 TEMPSUMMON_TIMED_DESPAWN, 120000))
+        {
+            _savedKrennanGUID = saved->GetGUID();
+            CastLater(saved, me->GetGUID(), SPELL_RIDE_VEHICLE, 100ms);
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (_startTimer)
+        {
+            if (_startTimer <= diff)
+            {
+                _startTimer = 0;
+                me->SetControlled(false, UNIT_STATE_ROOT);
+                _out.Start(me);
+            }
+            else
+                _startTimer -= diff;
+        }
+
+        if (_out.Ended(me) == 0)            // donor point 6: jump down to the tree
+        {
+            me->GetMotionMaster()->MoveJump(-1681.62219f, 1346.7093f, 15.13f, 20.0f, 15.0f, 1);
+            if (Creature* krennan = me->FindNearestCreature(NPC_KRENNAN_ARANAS, 40.0f))
+                if (krennan->AI())
+                    krennan->AI()->Talk(0);
+            Talk(0, ObjectAccessor::GetPlayer(*me, _playerGUID), 1500ms);
+        }
+
+        if (_back.Ended(me) == 0)           // donor point 13: back at the square
+        {
+            DoCastSelf(SPELL_EJECT_ALL_PASSENGERS, true);
+            if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+                player->ExitVehicle();
+            if (Creature* krennan = ObjectAccessor::GetCreature(*me, _savedKrennanGUID))
+            {
+                krennan->ExitVehicle();
+                krennan->NearTeleportTo(-1772.452f, 1436.7318f, 19.7590f, 2.9347f);
+                CastLater(krennan, krennan->GetGUID(), SPELL_DUMMY_PING, 1000ms);
+            }
+            me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+            me->DespawnOrUnsummon(1s);
+        }
+    }
+
+private:
+    GilneasPath _out, _back;
+    ObjectGuid _playerGUID, _savedKrennanGUID;
+    uint32 _startTimer = 0;
+};
