+// A lassoed horse: follows the player's horse on a rope, and counts when that horse is credited
+struct npc_summoned_mountain_horse_worgen : public ScriptedAI
+{
+    npc_summoned_mountain_horse_worgen(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        Player* player = summoner->ToPlayer();
+        if (!player)
+        {
+            me->DespawnOrUnsummon();
+            return;
+        }
+        _playerGUID = player->GetGUID();
+        if (Unit* vehicle = player->GetVehicleBase())
+            _vehicleGUID = vehicle->GetGUID();
+        _followTimer = 100;
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (_followTimer)
+        {
+            if (_followTimer <= diff)
+            {
+                _followTimer = 0;
+                if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+                {
+                    me->CastSpell(player, SPELL_ROPE_CHANNEL, true);
+                    me->GetMotionMaster()->MoveFollow(player, frand(1.0f, 3.0f), frand(0.1f, 3.0f) * float(M_PI));
+                }
+            }
+            else
+                _followTimer -= diff;
+        }
+
+        if (_rootTimer)
+        {
+            if (_rootTimer <= diff)
+            {
+                _rootTimer = 0;
+                DoCastSelf(SPELL_ROOT, true);
+            }
+            else
+                _rootTimer -= diff;
+        }
+
+        if (_done)
+            return;
+        if (_checkTimer > diff)
+        {
+            _checkTimer -= diff;
+            return;
+        }
+        _checkTimer = 1000;
+
+        Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID);
+        if (!player)
+            return;
+        if (!player->GetVehicleBase())
+        {
+            Creature* vehicle = ObjectAccessor::GetCreature(*me, _vehicleGUID);
+            player->RemoveAurasDueToSpell(SPELL_ROPE_CHANNEL);
+            me->InterruptNonMeleeSpells(false);
+            _done = true;
+            if (vehicle && vehicle->AI() && vehicle->AI()->GetData(DATA_HORSE_CREDITED))
+            {
+                player->KilledMonsterCredit(NPC_CREDIT_HORSE);
+                me->DespawnOrUnsummon(8s);
+                _rootTimer = 2500;
+            }
+            else
+                me->DespawnOrUnsummon();
+            return;
+        }
+        if (me->GetDistance(player) > 100.0f)
+            me->DespawnOrUnsummon();
+    }
+
+private:
+    ObjectGuid _playerGUID, _vehicleGUID;
+    uint32 _checkTimer = 2000;
+    uint32 _followTimer = 0;
+    uint32 _rootTimer = 0;
+    bool _done = false;
+};
