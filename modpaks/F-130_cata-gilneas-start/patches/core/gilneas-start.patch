+static void DismountAndCancelShapeshifts(Unit* unit)
+{
+    unit->RemoveAurasByType(SPELL_AURA_MOUNTED);
+    unit->RemoveAurasByType(SPELL_AURA_MOD_SHAPESHIFT);
+}
+
+struct npc_drowning_watchtman_spellclick : public ScriptedAI
+{
+    npc_drowning_watchtman_spellclick(Creature* creature) : ScriptedAI(creature) { }
+
+    void SpellHit(Unit* caster, SpellInfo const* spell) override
+    {
+        Player* player = caster ? caster->ToPlayer() : nullptr;
+        if (spell->Id != SPELL_DUMMY_SPELLCLICK || _onBack || !player)
+            return;
+        _playerGUID = player->GetGUID();
+        DismountAndCancelShapeshifts(player);
+        player->CastSpell(player, SPELL_SET_VEHICLE_ID, true);
+        CastLater(me, player->GetGUID(), SPELL_RIDE_PLAYER, 100ms);
+        me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+        _onBack = true;
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!_onBack)
+            return;
+        if (_checkTimer > diff)
+        {
+            _checkTimer -= diff;
+            return;
+        }
+        _checkTimer = 1000;
+
+        Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID);
+        if (!player)
+        {
+            me->DespawnOrUnsummon();
+            return;
+        }
+        if (player->FindNearestCreature(NPC_GREYMANE_GASPING, 8.0f) && !player->IsInWater())
+        {
+            me->RemoveAurasDueToSpell(SPELL_DROWNING);
+            me->ExitVehicle();
+            me->SetFacingToObject(player);
+            Talk(0, player, 1s);
+            player->KilledMonsterCredit(NPC_GASPING_CREDIT);
+            player->RemoveAurasDueToSpell(SPELL_SET_VEHICLE_ID);
+            me->DespawnOrUnsummon(5s);
+            _onBack = false;
+            return;
+        }
+        if (!player->IsAlive() || !player->HasAura(SPELL_SET_VEHICLE_ID) ||
+            player->GetQuestStatus(QUEST_GASPING_FOR_BREATH) == QUEST_STATUS_NONE || me->GetDistance(player) > 30.0f)
+        {
+            player->RemoveAurasDueToSpell(SPELL_SET_VEHICLE_ID);
+            me->DespawnOrUnsummon();
+            _onBack = false;
+        }
+    }
+
+private:
+    bool _onBack = false;
+    ObjectGuid _playerGUID;
+    uint32 _checkTimer = 2000;
+};
