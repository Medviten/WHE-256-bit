+/* q14154 "By the Skin of His Teeth": Lord Darius Crowley's defence. The player's quest accept pings the controller,
+ * which sends seven waves of worgen at the barricade for two minutes and credits whoever is still there. */
+enum ByTheSkin
+{
+    NPC_WORGEN_ALPHA                = 35170,
+    NPC_WORGEN_RUNT                 = 35188,
+    SPELL_BY_THE_SKIN_AURA          = 68218,
+    SPELL_REBEL_VALOR               = 67503,
+    QUEST_BY_THE_SKIN_OF_HIS_TEETH  = 14154,
+};
+
+static Position const WorgenSpawnPosition[] =
+{
+    { -1632.79f, 1485.66f, 74.94f, 3.76f },
+    { -1717.72f, 1486.31f, 57.22f, 5.37f },
+    { -1594.07f, 1408.40f, 72.84f, 2.83f },
+};
+
+struct npc_by_the_skin_of_his_teeth_controller : public ScriptedAI
+{
+    npc_by_the_skin_of_his_teeth_controller(Creature* creature) : ScriptedAI(creature), _summons(me) { }
+
+    // donor waves: (spawn point, runts, data the summons get)
+    struct Wave { uint8 at; uint8 runts; uint32 data; Milliseconds time; };
+    static constexpr Wave Waves[] =
+    {
+        { 0, 7, 1, 4s }, { 1, 4, 2, 18s }, { 1, 8, 2, 24s }, { 2, 6, 3, 46s }, { 2, 5, 3, 52s }, { 0, 6, 1, 73s },
+        { 0, 7, 1, 85s },
+    };
+
+    void Reset() override
+    {
+        _events.Reset();
+        me->setActive(true);
+        _started = false;
+        _summons.DespawnAll();
+        _finishTimer = 119000;
+        _checkTimer = 6000;
+        me->RemoveAurasDueToSpell(SPELL_REBEL_VALOR);
+        ForPlayers(150.0f, [](Player* p) { p->RemoveAurasDueToSpell(SPELL_BY_THE_SKIN_AURA); });
+    }
+
+    template <typename F> void ForPlayers(float range, F f)
+    {
+        for (auto const& ref : me->GetMap()->GetPlayers())
+            if (Player* p = ref.GetSource())
+                if (p->IsAlive() && me->IsWithinDistInMap(p, range))
+                    f(p);
+    }
+
+    void SpellHit(Unit* caster, SpellInfo const* spell) override
+    {
+        Player* player = caster ? caster->ToPlayer() : nullptr;
+        if (spell->Id != SPELL_DUMMY_PING || !player)
+            return;
+
+        player->CastSpell(player, SPELL_BY_THE_SKIN_AURA, true);
+        if (_started)
+        {
+            Talk(1, player);
+            return;
+        }
+        _started = true;
+        DoCastSelf(SPELL_REBEL_VALOR, true);
+        Talk(0);
+        for (uint32 i = 0; i < std::size(Waves); ++i)
+            _events.ScheduleEvent(i + 1, Waves[i].time);
+    }
+
+    void JustSummoned(Creature* summon) override { _summons.Summon(summon); }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+        while (uint32 id = _events.ExecuteEvent())
+        {
+            Wave const& w = Waves[id - 1];
+            for (uint8 i = 0; i <= w.runts; ++i)    // the runts, then an alpha
+                if (Creature* c = me->SummonCreature(i < w.runts ? NPC_WORGEN_RUNT : NPC_WORGEN_ALPHA,
+                                                     WorgenSpawnPosition[w.at], TEMPSUMMON_TIMED_DESPAWN, 85000))
+                    if (c->AI())
+                        c->AI()->SetData(1, w.data);
+        }
+
+        if (!_started)
+            return;
+
+        if (_checkTimer <= diff)
+        {
+            _checkTimer = 2000;
+            if (!me->SelectNearestPlayer(55.0f))
+            {
+                Reset();
+                return;
+            }
+        }
+        else
+            _checkTimer -= diff;
+
+        if (_finishTimer <= diff)
+        {
+            _finishTimer = 5000;
+            bool credited = false;
+            ForPlayers(100.0f, [&credited](Player* p)
+            {
+                QuestStatus status = p->GetQuestStatus(QUEST_BY_THE_SKIN_OF_HIS_TEETH);
+                if (status == QUEST_STATUS_INCOMPLETE || status == QUEST_STATUS_COMPLETE)
+                {
+                    p->AreaExploredOrEventHappens(QUEST_BY_THE_SKIN_OF_HIS_TEETH);
+                    p->RemoveAurasDueToSpell(SPELL_BY_THE_SKIN_AURA);
+                    credited = true;
+                }
+            });
+            if (credited)
+                Reset();
+        }
+        else
+            _finishTimer -= diff;
+    }
+
+private:
+    EventMap _events;
+    SummonList _summons;
+    bool _started = false;
+    uint32 _checkTimer = 6000;
+    uint32 _finishTimer = 119000;
+};
+
+/* q14204 "From the Shadows": the player's mastiff follows, attacks the lurkers its ping reveals and helps in fights. */
+enum MastiffPet
+{
+    QUEST_FROM_THE_SHADOWS = 14204,
+};
+
+struct npc_gilnean_mastiff_pet : public ScriptedAI
+{
+    npc_gilnean_mastiff_pet(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        if (Player* player = summoner->ToPlayer())
+        {
+            _playerGUID = player->GetGUID();
+            me->GetMotionMaster()->MoveFollow(player, 0.9f, 0.5f * float(M_PI));
+        }
+    }
+
+    void SpellHit(Unit* caster, SpellInfo const* spell) override
+    {
+        if (spell->Id != SPELL_DUMMY_PING || !caster)
+            return;
+        me->SetReactState(REACT_AGGRESSIVE);
+        AttackStart(caster);
+        if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+            player->Attack(caster, true);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        DoMeleeAttackIfReady();
+
+        if (_checkTimer > diff)
+        {
+            _checkTimer -= diff;
+            return;
+        }
+        _checkTimer = 1000;
+
+        Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID);
+        if (!player || !player->IsAlive() || QuestNoneOrRewarded(player, QUEST_FROM_THE_SHADOWS))
+        {
+            me->DespawnOrUnsummon();
+            return;
+        }
+        if (!me->GetVictim() && me->GetReactState() != REACT_AGGRESSIVE && player->GetVictim())
+        {
+            me->SetReactState(REACT_AGGRESSIVE);
+            AttackStart(player->GetVictim());
+        }
+        if (me->GetReactState() != REACT_PASSIVE && !player->GetVictim())
+        {
+            me->SetReactState(REACT_PASSIVE);
+            me->CombatStop();
+            me->GetThreatMgr().ClearAllThreat();
+            me->GetMotionMaster()->MoveFollow(player, 0.9f, 0.5f * float(M_PI));
+        }
+    }
+
+private:
+    ObjectGuid _playerGUID;
+    uint32 _checkTimer = 1000;
+};
