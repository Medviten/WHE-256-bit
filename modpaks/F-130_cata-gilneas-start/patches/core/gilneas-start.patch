+struct npc_crowleys_horse_vehicle : public ScriptedAI
+{
+    npc_crowleys_horse_vehicle(Creature* creature) : ScriptedAI(creature),
+        _p1(CrowleysHorsePath1, { 1 }), _p2(CrowleysHorsePath2, { 14 }), _p3(CrowleysHorsePath3, { 22 }) { }
+
+    enum Events { EVENT_PATH_1 = 1, EVENT_JUMP_1, EVENT_PATH_2, EVENT_JUMP_2, EVENT_PATH_3, EVENT_END };
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        if (Player* player = summoner->ToPlayer())
+            _playerGUID = player->GetGUID();
+        Talk(0);
+        if (Creature* crowley = me->SummonCreature(NPC_CROWLEY_PASSENGER, me->GetPosition(), TEMPSUMMON_DEAD_DESPAWN, 5000))
+        {
+            _crowleyGUID = crowley->GetGUID();
+            crowley->EnterVehicle(me, 1);
+        }
+    }
+
+    void PassengerBoarded(Unit* passenger, int8 /*seatId*/, bool apply) override
+    {
+        if (!passenger->IsPlayer())
+            return;
+        Creature* crowley = ObjectAccessor::GetCreature(*me, _crowleyGUID);
+        if (apply)
+        {
+            if (crowley && crowley->AI())
+                crowley->AI()->Talk(0);
+            _events.ScheduleEvent(EVENT_PATH_1, 1s);
+        }
+        else
+        {
+            me->DespawnOrUnsummon(1s);
+            if (crowley)
+                crowley->DespawnOrUnsummon();
+        }
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        DoCastSelf(SPELL_EJECT_ALL_PASSENGERS, true);
+        if (Creature* crowley = ObjectAccessor::GetCreature(*me, _crowleyGUID))
+            crowley->DespawnOrUnsummon();
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (_p1.Ended(me) == 0)
+            _events.ScheduleEvent(EVENT_JUMP_1, 2s);
+        if (_p2.Ended(me) == 0)
+            _events.ScheduleEvent(EVENT_JUMP_2, 2s);
+        if (_p3.Ended(me) == 0)
+            _events.ScheduleEvent(EVENT_END, 1s);
+
+        _events.Update(diff);
+        while (uint32 id = _events.ExecuteEvent())
+        {
+            switch (id)
+            {
+                case EVENT_PATH_1: _p1.Start(me); break;
+                case EVENT_JUMP_1:
+                    me->GetMotionMaster()->MoveJump(-1718.71f, 1662.46f, 20.50f, 15.0f, 20.0f);
+                    _events.ScheduleEvent(EVENT_PATH_2, 1500ms);
+                    break;
+                case EVENT_PATH_2: _p2.Start(me); break;
+                case EVENT_JUMP_2:
+                    me->GetMotionMaster()->MoveJump(-1576.42f, 1713.106f, 20.484f, 15.0f, 20.0f);
+                    _events.ScheduleEvent(EVENT_PATH_3, 1500ms);
+                    break;
+                case EVENT_PATH_3: _p3.Start(me); break;
+                case EVENT_END:
+                    DoCastSelf(SPELL_EJECT_ALL_PASSENGERS, true);
+                    me->DespawnOrUnsummon(200ms);
+                    if (Creature* crowley = ObjectAccessor::GetCreature(*me, _crowleyGUID))
+                        crowley->DespawnOrUnsummon();
+                    if (Player* player = ObjectAccessor::GetPlayer(*me, _playerGUID))
+                    {
+                        player->CastSpell(player, SPELL_SANCTUARY_NO_COMBAT, true);
+                        player->GetMotionMaster()->MoveJump(-1543.589f, 1572.651f, 29.202f, 10.0f, 10.0f);
+                    }
+                    break;
+            }
+        }
+
+        if (me->IsInCombat())
+        {
+            if (_sayTimer <= diff)
+            {
+                _sayTimer = urand(25000, 40000);
+                if (Creature* crowley = ObjectAccessor::GetCreature(*me, _crowleyGUID))
+                    if (crowley->AI())
+                        crowley->AI()->Talk(1);
+            }
+            else
+                _sayTimer -= diff;
+        }
+    }
+
+private:
+    GilneasPath _p1, _p2, _p3;
+    EventMap _events;
+    ObjectGuid _playerGUID, _crowleyGUID;
+    uint32 _sayTimer = 5000;
+};
