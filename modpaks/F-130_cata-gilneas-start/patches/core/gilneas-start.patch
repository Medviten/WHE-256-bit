+/*
+ * Custom: F-130 Gilneas (Worgen) start zone.
+ *
+ * Creature and spell scripts ported from Project Neltharion (4.3.4), scripts/EasternKingdoms/Gilneas/gilneas.cpp,
+ * under the same script names, which the modpak's creature_template / spell_script_names rows use.
+ *
+ * Porting rules, as in zeppelin_goblin_creatures.cpp:
+ * - Coordinates are the donor's: Cataclysm's Gilneas map (654) lies on Open Azeroth's Eastern Kingdoms (map 0) at
+ *   the same coordinates.
+ * - AzerothCore's spline paths report no waypoints, so the donor's MoveSmoothPath + MovementInform(point) becomes a
+ *   path cut into legs at the points the donor acted on, each leg's end found by polling movespline->Finalized().
+ * - Neltharion's server-only marker spells (151100, 151174, 151235...) aren't needed in C++: the scripts keep the
+ *   state themselves (151235, which SmartAI casts too, has a spell script below).
+ * - CastWithDelay / TalkWithDelay become events on the caster and Talk(id, target, delay).
+ * - These AIs extend ScriptedAI even for vehicles: VehicleAI's 5s auto-dismiss races the despawn timings.
+ */
+
+#include "CreatureScript.h"
+#include "GameObject.h"
+#include "MotionMaster.h"
+#include "MoveSpline.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "PlayerScript.h"
+#include "ScriptedCreature.h"
+#include "SpellAuraEffects.h"
+#include "SpellInfo.h"
+#include "SpellScript.h"
+#include "SpellScriptLoader.h"
+#include "TemporarySummon.h"
+#include "Vehicle.h"
+#include "World.h"
+
+enum GilneasShared
+{
+    SPELL_RIDE_VEHICLE              = 46598,
+    SPELL_EJECT_ALL_PASSENGERS      = 50630,
+    SPELL_ROOT                      = 42716,
+    SPELL_DUMMY_PING                = 98914,
+    SPELL_DUMMY_SPELLCLICK          = 56685,
+    SPELL_SANCTUARY_NO_COMBAT       = 88467,
+    SPELL_FLIGHT_SPEED_280          = 50345,
+    SPELL_FLIGHT_SPEED_180          = 47433,
+};
+
+// A donor path cut into legs: each leg is run with MoveSplinePath and its end polled.
+struct GilneasPath
+{
+    std::vector<Movement::PointsArray> legs;
+    size_t next = 0;
+    bool running = false;
+
+    GilneasPath(G3D::Vector3 const* points, std::initializer_list<size_t> lastOfLeg)
+    {
+        size_t from = 0;
+        for (size_t last : lastOfLeg)
+        {
+            legs.emplace_back(points + from, points + last + 1);
+            from = last + 1;
+        }
+    }
+
+    void Start(Creature* me, size_t leg = 0)
+    {
+        next = leg;
+        Continue(me);
+    }
+
+    bool Continue(Creature* me)
+    {
+        if (next >= legs.size())
+            return false;
+        me->GetMotionMaster()->Clear();
+        me->GetMotionMaster()->MoveSplinePath(&legs[next++]);
+        running = true;
+        return true;
+    }
+
+    // The leg that has just ended, or -1
+    int Ended(Creature* me)
+    {
+        if (!running || !me->movespline->Finalized())
+            return -1;
+        running = false;
+        return int(next) - 1;
+    }
+
+    void Stop() { running = false; }
+};
+
+static void CastLater(Unit* caster, ObjectGuid target, uint32 spell, Milliseconds delay)
+{
+    caster->m_Events.AddEventAtOffset([caster, target, spell]()
+    {
+        if (Unit* t = ObjectAccessor::GetUnit(*caster, target))
+            caster->CastSpell(t, spell, true);
+    }, delay);
+}
+
+static bool QuestNoneOrRewarded(Player* player, uint32 quest)
+{
+    QuestStatus status = player->GetQuestStatus(quest);
+    return status == QUEST_STATUS_NONE || status == QUEST_STATUS_REWARDED;
+}
+
+static void OpenGate(Creature* me, uint32 entry, uint32 seconds)
+{
+    if (GameObject* gate = me->FindNearestGameObject(entry, 40.0f))
+    {
+        gate->SetLootState(GO_READY);
+        gate->UseDoorOrButton(seconds, false, me);
+    }
+}
