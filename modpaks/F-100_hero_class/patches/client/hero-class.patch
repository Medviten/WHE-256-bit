+    return 1 + (left < HERO_SPELL_TABS_PER_PAGE ? left : HERO_SPELL_TABS_PER_PAGE);
+}
+
+uint32_t SpellBookHeroMapTab(uint32_t index) {
+    if (!index || s_numSkillInfos <= HERO_SPELL_TABS_PER_PAGE + 1) {
+        return index;
+    }
+
+    SpellBookHeroTabCount();
