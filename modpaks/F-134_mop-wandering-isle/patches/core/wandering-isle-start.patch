+// Fly `points` as one spline; true while it is still flying
+static void FlySpline(Creature* creature, std::vector<Position> const& points, float speed)
+{
+    Movement::PointsArray path;
+    path.emplace_back(creature->GetPositionX(), creature->GetPositionY(), creature->GetPositionZ());
+    for (Position const& pos : points)
+        path.emplace_back(pos.GetPositionX(), pos.GetPositionY(), pos.GetPositionZ());
+    creature->SetSpeed(MOVE_RUN, speed / baseMoveSpeed[MOVE_RUN]);
+    creature->SetSpeed(MOVE_FLIGHT, speed / baseMoveSpeed[MOVE_FLIGHT]);
+    creature->GetMotionMaster()->Clear();
+    creature->GetMotionMaster()->MoveSplinePath(&path);
+}
