+// 55685 - Uplifting Draft (29776): lifts the rider to the upper ledge, ejects it 20.8 s after boarding
+struct npc_uplifting_draft : public ScriptedAI
+{
+    npc_uplifting_draft(Creature* creature) : ScriptedAI(creature) { }
+
+    void PassengerBoarded(Unit* passenger, int8 /*seatId*/, bool apply) override
+    {
+        if (!apply || !passenger || !passenger->IsPlayer())
+            return;
+        ObjectGuid passengerGuid = passenger->GetGUID();
+        me->SetDisableGravity(true);
+        me->SetCanFly(true);
+        _scheduler.Schedule(4600ms, [this](TaskContext /*task*/)
+        {
+            me->GetMotionMaster()->MovePoint(0, Position(920.45f, 3604.77f, 253.17f), FORCED_MOVEMENT_NONE, 48.0f, false);
+        });
+        _scheduler.Schedule(20800ms, [this, passengerGuid](TaskContext /*task*/)
+        {
+            Player* player = ObjectAccessor::GetPlayer(*me, passengerGuid);
+            DoCastSelf(Spells::EjectAllPassengers, true);
+            if (player)
+            {
+                player->NearTeleportTo(920.44965f, 3604.7708f, 255.17317f, 2.7885048f);
+                DoCast(player, Spells::UpliftingDraftLaunch, true);
+            }
+            me->DespawnOrUnsummon(2s);
+        });
+    }
+
+    void UpdateAI(uint32 diff) override { _scheduler.Update(diff); }
+
+private:
+    TaskScheduler _scheduler;
+};
