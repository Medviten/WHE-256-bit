+// 54856 - Master Li Fei (Summon)
+struct npc_master_li_fei_summon : public ScriptedAI
+{
+    npc_master_li_fei_summon(Creature* creature) : ScriptedAI(creature) { }
+
+    void FaceToPlayer()
+    {
+        if (TempSummon* summon = me->ToTempSummon())
+            if (Unit* summoner = summon->GetSummonerUnit())
+                me->SetFacingToObject(summoner);
+    }
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        if (!summoner || !summoner->IsPlayer())
+            return;
+
+        StartPath(me, PATH_MASTER_LI);
+        Milliseconds delay = 23s;
+        _scheduler.Schedule(delay, [this](TaskContext) { FaceToPlayer(); });
+        // (delay, text): TrinityCore's timeline for the meditation's lines
+        std::pair<Milliseconds, uint8> const lines[] = { { 2s, 0 }, { 10s, 1 }, { 12s, 2 }, { 11s, 3 }, { 11s, 4 }, { 11s, 5 } };
+        for (auto const& [step, text] : lines)
+        {
+            delay += step;
+            uint8 const t = text;
+            _scheduler.Schedule(delay, [this, t](TaskContext)
+            {
+                if (t == 3 || t == 5)
+                    FaceToPlayer();
+                Talk(t);
+            });
+        }
+        delay += 6s;
+        _scheduler.Schedule(delay, [this](TaskContext)
+        {
+            if (Creature* aysa = me->FindNearestCreature(Creatures::AysaQuest29414, 40.0f))
+                aysa->AI()->DoAction(ACTION_FINISH_MEDITATION);
+            DoCastSelf(SPELL_UPDATE_PHASE_SHIFT_DEMON_CREATOR, true);
+            Talk(6);
+            me->DespawnOrUnsummon(200ms);
+        });
+    }
+
+    void UpdateAI(uint32 diff) override { _scheduler.Update(diff); }
+
+private:
+    TaskScheduler _scheduler;
+};
