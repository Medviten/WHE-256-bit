+// 55649 - Shang Xi's Hot Air Balloon (29791): four legs
+struct npc_shang_xi_hot_air_balloon : public ScriptedAI
+{
+    npc_shang_xi_hot_air_balloon(Creature* creature) : ScriptedAI(creature), _leg(0), _flying(false), _done(false) { }
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        Player* player = summoner ? summoner->ToPlayer() : nullptr;
+        if (!player)
+            return;
+        _playerGuid = player->GetGUID();
+        me->SetDisableGravity(true);
+        me->SetCanFly(true);
+        player->CastSpell(me, Spells::RideVehicleHardcoded, true);
+
+        _scheduler.Schedule(600ms, [this](TaskContext /*task*/)
+        {
+            if (Creature* aysa = me->FindNearestCreature(Creatures::BalloonAysa, 20.0f))
+                aysa->EnterVehicle(me, 1);
+            DoCastSelf(Spells::BalloonCreditStart, true);
+        });
+        _scheduler.Schedule(4s, [this](TaskContext /*task*/) { FlyLeg(); });
+    }
+
+    void FlyLeg()
+    {
+        FlightLeg const& leg = BalloonLegs()[_leg];
+        FlySpline(me, leg.Points, leg.Speed);
+        _flying = true;
+        if (_leg == BalloonLegs().size() - 1)
+            DoCastSelf(Spells::BalloonCreditAirship, true);
+    }
+
+    void LegEnded()
+    {
+        _flying = false;
+        if (++_leg < BalloonLegs().size())
+        {
+            FlyLeg();
+            return;
+        }
+        _done = true;
+        _scheduler.Schedule(1600ms, [this](TaskContext /*task*/)
+        {
+            Player* player = ObjectAccessor::GetPlayer(*me, _playerGuid);
+            if (player && player->GetVehicleBase() == me)
+            {
+                Position const exitPos = { 746.39276f, 3665.7275f, 194.19475f, 0.6864777f };
+                player->ExitVehicle(&exitPos);
+                DoCast(player, Spells::Parachute, true);
+            }
+            me->DespawnOrUnsummon(1s);
+        });
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _scheduler.Update(diff);
+        if (_flying && !_done && me->movespline->Finalized())
+            LegEnded();
+    }
+
+private:
+    TaskScheduler _scheduler;
+    ObjectGuid _playerGuid;
+    std::size_t _leg;
+    bool _flying;
+    bool _done;
+};
