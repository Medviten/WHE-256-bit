+// ---- A New Fate (31450) ----------------------------------------------------------------------------------------------
+namespace NewFate
+{
+    static constexpr uint32 QuestANewFate = 31450;
+    static constexpr uint32 TalkAccomplished = 0;
+    static constexpr uint32 TalkJourneysNotDone = 1;
+}
+
+// 56013 - Spirit of Master Shang Xi: F-020 / F-021's Pandaren already have their side, so instead of MoP's faction
+// choice the spirit completes "A New Fate" and sends them to their capital (Stormwind or Orgrimmar), bound there
+struct npc_spirit_of_master_shang_xi : public ScriptedAI
+{
+    npc_spirit_of_master_shang_xi(Creature* creature) : ScriptedAI(creature) { }
+
+    void sQuestAccept(Player* player, Quest const* quest) override
+    {
+        if (quest->GetQuestId() == NewFate::QuestANewFate)
+            Talk(NewFate::TalkAccomplished, player);
+    }
+
+    void sGossipSelect(Player* player, uint32 menuId, uint32 /*gossipListId*/) override
+    {
+        if (menuId != Menu(13726) || player->GetQuestStatus(NewFate::QuestANewFate) != QUEST_STATUS_INCOMPLETE)
+            return;
+        CloseGossipMenuFor(player);
+        Talk(NewFate::TalkJourneysNotDone, player);
+        player->CompleteQuest(NewFate::QuestANewFate);
+        if (Quest const* quest = sObjectMgr->GetQuestTemplate(NewFate::QuestANewFate))
+            player->RewardQuest(quest, 0, me);
+
+        WorldLocation home = player->GetTeamId() == TEAM_ALLIANCE
+            ? WorldLocation(MAP_EASTERN_KINGDOMS, -8833.38f, 628.63f, 94.01f, 1.07f)     // Stormwind, Trade District
+            : WorldLocation(MAP_KALIMDOR, 1633.75f, -4439.39f, 15.43f, 0.0f);          // Orgrimmar, Valley of Strength
+        player->SetHomebind(home, player->GetTeamId() == TEAM_ALLIANCE ? AREA_STORMWIND_CITY : AREA_ORGRIMMAR);
+        player->TeleportTo(home);
+    }
+};
+}
