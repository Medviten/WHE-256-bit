+{
+    enum { EVENT_PATH_START = 1, EVENT_ROPES };
+
+    npc_delivery_cart(Creature* creature) : ScriptedAI(creature), _data(GetCartData(creature->GetEntry())) { }
+
+    void Reset() override { _events.Reset(); }
+
+    void PassengerBoarded(Unit* passenger, int8 /*seat*/, bool apply) override
+    {
+        Player* player = apply && passenger ? passenger->ToPlayer() : nullptr;
+        if (!player || !_data)
+            return;
+        me->CastSpell(player, Spells::ForceVehicleRide, true);
+        _events.ScheduleEvent(EVENT_PATH_START, 1800ms);
+        _events.ScheduleEvent(EVENT_ROPES, 1s);
+        if (player->hasQuest(_data->QuestId))
+            player->KilledMonsterCredit(_data->CreditNPC);
+    }
+
+    void WaypointReached(uint32 nodeId, uint32 /*pathId*/) override
+    {
+        if (_data && nodeId == _data->EjectNodeId)
+            me->CastSpell(me, Spells::EjectPassengers, true);
+    }
+
+    void WaypointPathEnded(uint32 /*nodeId*/, uint32 /*pathId*/) override { me->DespawnOrUnsummon(1s); }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            if (eventId == EVENT_ROPES)
+                me->CastSpell(me, Spells::OxCartRopeLeft, true);
+            else if (eventId == EVENT_PATH_START && _data)
+                StartPath(me, _data->PathId);
+        }
+    }
+
+private:
+    EventMap _events;
+    CartData const* _data;
+};
