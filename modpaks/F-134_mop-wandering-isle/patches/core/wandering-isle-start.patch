+
+// The spawn F-134 gave a TrinityCore StringId (wandering_isle_ids.h), near `near`
+static Creature* FindSpawn(WorldObject const* near, uint32 spawnId, float range = 40.0f)
+{
+    auto bounds = near->GetMap()->GetCreatureBySpawnIdStore().equal_range(spawnId);
+    for (auto itr = bounds.first; itr != bounds.second; ++itr)
+        if (itr->second->IsInWorld() && near->IsWithinDist(itr->second, range))
+            return itr->second;
+    return nullptr;
+}
+
+static void RefreshPhases(Unit* unit)
+{
+    if (Player* player = unit ? unit->ToPlayer() : nullptr)
+        if (PhaseMgr* pm = player->GetPhaseMgr())
+            pm->Recalculate();
+}
+
+// ---- Area triggers left: 3.3.5a clients only report entering --------------------------------------------------------
+class WanderingIsleTriggerExitScript;
+
+struct TriggerExits
+{
+    using Handler = void (*)(Player*);
+    // player -> (trigger, what to do on leaving it)
+    static std::unordered_map<ObjectGuid, std::unordered_map<uint32, Handler>>& Watched()
+    {
+        static std::unordered_map<ObjectGuid, std::unordered_map<uint32, Handler>> watched;
+        return watched;
+    }
+
+    static void Watch(Player* player, uint32 triggerId, Handler onExit)
+    {
+        Watched()[player->GetGUID()][triggerId] = onExit;
+    }
+};
+
+class WanderingIsleTriggerExitScript : public PlayerScript
+{
+public:
+    WanderingIsleTriggerExitScript() : PlayerScript("WanderingIsleTriggerExitScript", { PLAYERHOOK_ON_UPDATE, PLAYERHOOK_ON_LOGOUT }) { }
+
+    void OnPlayerUpdate(Player* player, uint32 diff) override
+    {
+        auto itr = TriggerExits::Watched().find(player->GetGUID());
+        if (itr == TriggerExits::Watched().end())
+            return;
+
+        uint32& timer = _timers[player->GetGUID()];
+        if (timer > diff)
+        {
+            timer -= diff;
+            return;
+        }
+        timer = 500;
+
+        for (auto watch = itr->second.begin(); watch != itr->second.end();)
+        {
+            AreaTrigger const* trigger = sObjectMgr->GetAreaTrigger(watch->first);
+            if (!trigger || trigger->map != player->GetMapId() || !player->IsInAreaTriggerRadius(trigger, 1.0f))
+            {
+                TriggerExits::Handler handler = watch->second;
+                watch = itr->second.erase(watch);
+                handler(player);
+            }
+            else
+                ++watch;
+        }
+        if (itr->second.empty())
+            TriggerExits::Watched().erase(itr);
+    }
+
+    void OnPlayerLogout(Player* player) override
+    {
+        TriggerExits::Watched().erase(player->GetGUID());
+        _timers.erase(player->GetGUID());
+    }
+
+private:
+    std::unordered_map<ObjectGuid, uint32> _timers;
+};
