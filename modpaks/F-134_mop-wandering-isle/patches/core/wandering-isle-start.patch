+// 54611 - Jaomin Ro
+struct npc_jaomin_ro : public ScriptedAI
+{
+    npc_jaomin_ro(Creature* creature) : ScriptedAI(creature), _depleted(false) { }
+
+    void Reset() override
+    {
+        _depleted = false;
+        _events.Reset();
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.ScheduleEvent(EVENT_RANDOM_SPELL, 4s, 6s);
+    }
+
+    void JustReachedHome() override
+    {
+        me->RemoveUnitFlag(UNIT_FLAG_NON_ATTACKABLE_2);
+        me->InitializeReactState();
+    }
+
+    void SpellHitTarget(Unit* target, SpellInfo const* spellInfo) override
+    {
+        if (spellInfo->Id == SPELL_CSA_AREATRIGGER_DUMMY && target->IsPlayer() && !me->IsInCombat())
+        {
+            Talk(SAY_INTRO, target);
+            me->SetOrientation(1.67690026f);
+            me->SetStandState(UNIT_STAND_STATE_STAND);
+            me->SetEmoteState(EMOTE_STATE_READY_UNARMED);
+        }
+    }
+
+    // TrinityCore's OnHealthDepleted: he yields at 1 health instead of dying
+    void DamageTaken(Unit* attacker, uint32& damage, DamageEffectType /*type*/, SpellSchoolMask /*school*/) override
+    {
+        if (damage < me->GetHealth())
+            return;
+        damage = me->GetHealth() > 1 ? me->GetHealth() - 1 : 0;
+        if (_depleted)
+            return;
+        _depleted = true;
+
+        me->SetReactState(REACT_PASSIVE);
+        me->AttackStop();
+        me->RemoveAllAuras();
+        me->InterruptNonMeleeSpells(true);
+        _events.Reset();
+        me->SetUnitFlag(UNIT_FLAG_NOT_SELECTABLE);
+        me->SetUnitFlag(UNIT_FLAG_NON_ATTACKABLE_2);
+        me->SetEmoteState(EMOTE_ONESHOT_NONE);
+        DoCast(me, SPELL_SERVERSIDE_KILL_CREDIT, true);
+        if (attacker)
+            if (Player* player = attacker->GetCharmerOrOwnerPlayerOrPlayerItself())
+                player->KilledMonsterCredit(me->GetEntry());
+        Talk(SAY_DEFEATED, attacker);
+        _events.ScheduleEvent(EVENT_HEAL, 5s);
+        _events.ScheduleEvent(EVENT_MOVE_HOME, 6s);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+        switch (_events.ExecuteEvent())
+        {
+            case EVENT_HEAL:
+                DoCastSelf(SPELL_FULL_HEALTH, true);
+                me->RemoveUnitFlag(UNIT_FLAG_NOT_SELECTABLE);
+                return;
+            case EVENT_MOVE_HOME:
+                EnterEvadeMode();
+                return;
+            case EVENT_RANDOM_SPELL:
+                if (!me->HasUnitState(UNIT_STATE_CASTING | UNIT_STATE_STUNNED) && !me->HasAura(SPELL_RIDE_DRAKE))
+                    DoCast(RAND(SPELL_BABY_ELEPHANT_TAKES_A_BATH, SPELL_HAWK_DIVING_TO_EARTH));
+                _events.ScheduleEvent(EVENT_RANDOM_SPELL, 4s, 6s);
+                break;
+            default:
+                break;
+        }
+        if (!_depleted && UpdateVictim())
+            DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+    bool _depleted;
+};
