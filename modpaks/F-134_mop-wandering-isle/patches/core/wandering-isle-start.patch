+struct npc_min_dimwind_summon : public ScriptedAI
+{
+    npc_min_dimwind_summon(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(WorldObject* summoner) override
+    {
+        if (!summoner || !summoner->IsPlayer())
+            return;
+
+        Creature* scamp1 = FindSpawn(me, SPAWN_NPC_AMBERLEAF_SCAMP_1, 20.0f);
+        Creature* scamp2 = FindSpawn(me, SPAWN_NPC_AMBERLEAF_SCAMP_2, 20.0f);
+        Creature* scamp3 = FindSpawn(me, SPAWN_NPC_AMBERLEAF_SCAMP_3, 20.0f);
+        Creature* scamp5 = FindSpawn(me, SPAWN_NPC_AMBERLEAF_SCAMP_5, 20.0f);
+        if (!scamp1 || !scamp2 || !scamp3 || !scamp5)
+            return;
+
+        scamp1->AI()->Talk(SAY_AMBERLEAF_SCAMP_0);
+        scamp1->GetMotionMaster()->MovePoint(0, amberleafPos[0]);
+        scamp2->GetMotionMaster()->MovePoint(0, amberleafPos[1]);
+        scamp3->GetMotionMaster()->MovePoint(0, amberleafPos[2]);
+        scamp5->GetMotionMaster()->MovePoint(0, amberleafPos[4]);
+
+        _scheduler.Schedule(2s, [this](TaskContext /*task*/)
+        {
+            if (Creature* scamp4 = FindSpawn(me, SPAWN_NPC_AMBERLEAF_SCAMP_4, 20.0f))
+            {
+                scamp4->AI()->Talk(SAY_AMBERLEAF_SCAMP_1);
+                scamp4->GetMotionMaster()->MovePoint(0, amberleafPos[3]);
+            }
+        });
+        _scheduler.Schedule(5s, [this](TaskContext task)
+        {
+            Unit* summoner = me->ToTempSummon() ? me->ToTempSummon()->GetSummonerUnit() : nullptr;
+            if (!summoner)
+                return;
+            me->SetFacingToObject(summoner);
+            Talk(SAY_MIN_DIMWIND_TEXT_0, summoner);
+            task.Schedule(4s, [this](TaskContext task2)
+            {
+                Talk(SAY_MIN_DIMWIND_TEXT_1);
+                task2.Schedule(4s, [this](TaskContext /*task*/) { StartPath(me, PATH_MOVE_RUN); });
+            });
+        });
+    }
+
+    void WaypointReached(uint32 waypointId, uint32 pathId) override
+    {
+        if (pathId == Path(PATH_MOVE_RUN))
+        {
+            if (waypointId == WAYPOINT_TALK_0 || waypointId == WAYPOINT_TALK_1)
+                Talk(SAY_MIN_DIMWIND_TEXT_2);
+            else if (waypointId == WAYPOINT_MOVE_WALK)
+            {
+                Talk(SAY_MIN_DIMWIND_TEXT_3);
+                StartPath(me, PATH_MOVE_WALK);
+            }
+        }
+        else if (pathId == Path(PATH_MOVE_WALK) && waypointId == WAYPOINT_DESPAWN)
+        {
+            me->SetFacingTo(0.575958f);
+            me->DespawnOrUnsummon(2s);
+            _scheduler.Schedule(1s, [this](TaskContext /*task*/)
+            {
+                if (TempSummon* summon = me->ToTempSummon())
+                    if (Unit* summoner = summon->GetSummonerUnit())
+                    {
+                        summoner->RemoveAurasDueToSpell(SPELL_SUMMON_CART_DRIVER);
+                        RefreshPhases(summoner);
+                    }
+            });
+        }
+    }
+
+    void UpdateAI(uint32 diff) override { _scheduler.Update(diff); }
+
+private:
+    TaskScheduler _scheduler;
+};
