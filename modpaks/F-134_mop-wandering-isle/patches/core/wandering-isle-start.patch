+// 54734 - Master Li Fei (combat)
+struct npc_li_fei_combat : public ScriptedAI
+{
+    enum Events { EVENT_FEET_OF_FURY = 1, EVENT_SHADOW_KICK };
+
+    npc_li_fei_combat(Creature* creature) : ScriptedAI(creature), _defeatTriggered(false) { }
+
+    void Reset() override
+    {
+        _defeatTriggered = false;
+        _events.Reset();
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.ScheduleEvent(EVENT_FEET_OF_FURY, 6s);
+        _events.ScheduleEvent(EVENT_SHADOW_KICK, 10s);
+    }
+
+    void DamageTaken(Unit* attacker, uint32& damage, DamageEffectType /*type*/, SpellSchoolMask /*school*/) override
+    {
+        if (_defeatTriggered || !me->HealthBelowPctDamaged(50, damage))
+            return;
+        _defeatTriggered = true;
+        damage = 0;
+        me->HandleEmoteCommand(EMOTE_ONESHOT_SALUTE);
+
+        // TrinityCore credits everyone on the tap list; here the attacker and its group nearby
+        if (Player* player = attacker ? attacker->GetCharmerOrOwnerPlayerOrPlayerItself() : nullptr)
+        {
+            auto credit = [](Player* p)
+            {
+                p->KilledMonsterCredit(Creatures::MasterLiFeiCombat);
+                p->RemoveAurasDueToSpell(Spells::FireCrashCover);
+                p->RemoveAurasDueToSpell(Spells::FireCrashInvis);
+                p->RemoveAurasDueToSpell(Spells::FireCrashPhaseShift);
+            };
+            if (Group* group = player->GetGroup())
+            {
+                for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                    if (Player* member = ref->GetSource())
+                        if (member->IsWithinDist(me, 60.0f))
+                            credit(member);
+            }
+            else
+                credit(player);
+        }
+
+        if (Creature* liFei = me->FindNearestCreature(Creatures::MasterLiFei, 30.0f))
+            liFei->AI()->Talk(0, attacker);
+        EnterEvadeMode();
+    }
+
+    void KilledUnit(Unit* victim) override
+    {
+        if (Player* player = victim->ToPlayer())
+            player->FailQuest(Quests::OnlyTheWorthyShallPass);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+        _events.Update(diff);
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+        switch (_events.ExecuteEvent())
+        {
+            case EVENT_FEET_OF_FURY:
+                DoCastVictim(Spells::FeetOfFury);
+                _events.ScheduleEvent(EVENT_FEET_OF_FURY, 12s);
+                break;
+            case EVENT_SHADOW_KICK:
+                DoCastVictim(Spells::FlyingShadowKick);
+                _events.ScheduleEvent(EVENT_SHADOW_KICK, 15s);
+                break;
+            default:
+                break;
+        }
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+    bool _defeatTriggered;
+};
