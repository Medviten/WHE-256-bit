+// 55786 - Zhao-Ren (29786): circles, lands after 5 firework hits, flies again 18.7 s later
+struct boss_zhao_ren : public ScriptedAI
+{
+    static constexpr uint8 HitsToLand = 5;
+
+    boss_zhao_ren(Creature* creature) : ScriptedAI(creature), _hits(0), _grounded(false) { }
+
+    void Reset() override
+    {
+        _hits = 0;
+        _grounded = false;
+        _scheduler.CancelAll();
+        me->SetDisableGravity(true);
+        me->SetCanFly(true);
+        FlySpline(me, ZhaoRenCircle, 9.0f);
+        _scheduler.Schedule(5s, [this](TaskContext task)
+        {
+            if (!_grounded)
+                if (Player* player = me->SelectNearestPlayer(80.0f))
+                    if (player->GetQuestStatus(Quests::BattleForTheSkies) == QUEST_STATUS_INCOMPLETE)
+                        DoCast(player, Spells::ZhaoRenLightning);
+            task.Repeat(5s);
+        });
+    }
+
+    void DoAction(int32 action) override
+    {
+        if (action != ACTION_FIREWORK_HIT || _grounded || ++_hits < HitsToLand)
+            return;
+        _grounded = true;
+        _hits = 0;
+        me->GetMotionMaster()->Clear();
+        me->GetMotionMaster()->MovePoint(POINT_LANDING, ZhaoRenLandingSpot, FORCED_MOVEMENT_NONE, 11.11f, false);
+    }
+
+    void MovementInform(uint32 type, uint32 id) override
+    {
+        if (type != POINT_MOTION_TYPE || id != POINT_LANDING)
+            return;
+        DoCastSelf(Spells::ZhaoRenStunned, true);
+        _scheduler.Schedule(15500ms, [this](TaskContext /*task*/) { DoCastSelf(Spells::ZhaoRenShockwave); });
+        _scheduler.Schedule(18700ms, [this](TaskContext /*task*/)
+        {
+            _grounded = false;
+            FlySpline(me, ZhaoRenCircle, 9.0f);
+        });
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _scheduler.Update(diff);
+        if (!_grounded && me->movespline->Finalized() && !me->HasUnitState(UNIT_STATE_CASTING))
+            FlySpline(me, ZhaoRenCircle, 9.0f);                       // keep circling
+        if (UpdateVictim() && _grounded)
+            DoMeleeAttackIfReady();
+    }
+
+private:
+    TaskScheduler _scheduler;
+    uint8 _hits;
+    bool _grounded;
+};
