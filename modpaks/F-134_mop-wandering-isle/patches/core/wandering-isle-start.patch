+static void HandleEmoteNearbyTushuiTrainees(Creature* leader, Emote emote)
+{
+    std::list<Creature*> list;
+    leader->GetCreatureListWithEntryInGrid(list, { NPC_TUSHUI_TRAINEE_MALE, NPC_TUSHUI_TRAINEE_FEMALE }, 10.0f);
+    for (Creature* trainee : list)
+        if (trainee != leader && !trainee->IsInCombat() && !trainee->IsInEvadeMode() && trainee->IsAlive())
+            trainee->HandleEmoteCommand(emote);
+}
