+
+    void BeginSparring(ObjectGuid guid)
+    {
+        _partnerGuid = guid;
+        me->SetEmoteState(EMOTE_ONESHOT_NONE);
+        me->HandleEmoteCommand(EMOTE_ONESHOT_BOW);
+        _scheduler.Schedule(1s, [this](TaskContext /*task*/) { me->SetEmoteState(EMOTE_STATE_READY_UNARMED); });
+        _scheduler.Schedule(4s, [this](TaskContext task)
+        {
+            PlayRandomEmote();
+            task.Repeat(4s);
+        });
+    }
+
+    Creature* GetNewPartner() const
+    {
+        std::list<Creature*> list;
+        me->GetCreatureListWithEntryInGrid(list, { NPC_HUOJIN_TRAINEE_MALE, NPC_HUOJIN_TRAINEE_FEMALE }, 10.0f);
+        Creature* best = nullptr;
+        float bestDist = 10.0f;
+        for (Creature* c : list)
+        {
+            if (c == me || c->IsInCombat() || c->IsInEvadeMode() || c->isDead())
+                continue;
+            float dist = c->GetDistance(me);
+            if (dist < bestDist)
+            {
+                bestDist = dist;
+                best = c;
+            }
+        }
+        return best;
+    }
+
+    void BeginSparringDelayed(ObjectGuid partnerGuid)
+    {
+        _partnerGuid = partnerGuid;
+        _scheduler.Schedule(1s, [this, partnerGuid](TaskContext /*task*/) { BeginSparring(partnerGuid); });
+    }
+
+    void InitiateSparring()
+    {
+        Creature* partner = GetNewPartner();
+        if (!partner)
+            return;
+        BeginSparring(partner->GetGUID());
+        if (npc_huojin_trainee* ai = CAST_AI(npc_huojin_trainee, partner->AI()))
+            ai->BeginSparringDelayed(me->GetGUID());
+    }
+
+    void JustReachedHome() override { InitiateSparring(); }
+
+    void JustRespawned() override
+    {
+        if (!ObjectAccessor::GetCreature(*me, _partnerGuid))
+            InitiateSparring();
+    }
+
+    void InitializeAI() override
+    {
+        npc_tushui_huojin_trainee::InitializeAI();
+        _scheduler.Schedule(2s, [this](TaskContext /*task*/)
+        {
+            if (!ObjectAccessor::GetCreature(*me, _partnerGuid))
+                InitiateSparring();
+        });
+    }
+
+private:
+    ObjectGuid _partnerGuid;
+};
