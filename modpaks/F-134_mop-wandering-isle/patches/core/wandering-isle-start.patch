+    npc_injured_sailor(Creature* creature) : ScriptedAI(creature) { }
+
+    void OnSpellClick(Unit* clicker, bool& /*result*/) override
+    {
+        Player* player = clicker ? clicker->ToPlayer() : nullptr;
