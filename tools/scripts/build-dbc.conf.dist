MODPAKS="/path/to/WHE-256-bit/modpaks"
DBCTOOL="/path/to/dbctool"
ORIGINAL_DBC="/path/to/dbctool/originaldbc"
LOCAL_SERVER_DBC="/path/to/server/data/dbc"

MYSQL_HOST="127.0.0.1"
MYSQL_PORT="63306"
MYSQL_USER="acore"
MYSQL_PASSWORD="acore"

DBC_DATABASE="dbc"

SERVER_HOST="medviten@100.110.63.66"
SERVER_DBC="/path/to/server/data/dbc"

EXTRA_SQL_DATABASES=("test_world" "test_world")
EXTRA_SQL_PATTERNS=("sql/db-world/base/*.sql" "sql/db-world/extra/*F-004*.sql")
EXTRA_SQL_DUMPS=("/path/to/ac-worldserver.sql")

LOCAL_SOURCE_DIR="/home/youruser/dev/wow-modpaks"
REMOTE_SOURCE_DIR="/home/youruser/wow"

# Clean baseline DBC database dump to load instead of reimporting DBCs every
# time (a fresh dbctool import of the stock DBCs, before any modpak SQL).
# If unset, the only *.sql file directly inside ORIGINAL_DBC is used.
DBC_DUMP="/path/to/dbc-baseline.sql"

# Extra SQL databases with a dump in EXTRA_SQL_DUMPS are only rebuilt when
# something that feeds them changed (dump, modpak SQL, variables, read DBC
# data). Set to true (or pass --force-rebuild) to always rebuild them.
FORCE_REBUILD=false

# Where build-dbc.sh writes combined-<target>.patch, collected from the
# patches/<target>/ folders of the modpaks in the manifest (see README).
# Defaults to this directory.
#PATCH_OUTPUT_DIR="/path/to/combined/patches"
